        <dc:Bounds x="1852" y="442" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_take_back_the_applied_row_and_balances" bpmnElement="take_back_the_applied_row_and_balances">
        <dc:Bounds x="1180" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_report_the_corrected_row_and_balances" bpmnElement="report_the_corrected_row_and_balances">
        <dc:Bounds x="1372" y="442" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_does_the_edited_date_land_today_or_earlier" bpmnElement="does_the_edited_date_land_today_or_earlier" isMarkerVisible="true">
        <dc:Bounds x="725" y="435" width="50" height="50" />
      </bpmndi:BPMNShape>
