<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="definitions" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:process id="process_household_bookkeeper">
    <bpmn:userTask id="name_the_entry_or_pick_from_the_last_ten_rows" name="Name the entry or pick from the last ten rows" />
    <bpmn:startEvent id="a_recorded_figure_turns_out_wrong_or_a_plan_needs_adjusting" name="A recorded figure turns out wrong or a plan needs adjusting" />
    <bpmn:receiveTask id="read_the_outcome_of_the_correction" name="Read the outcome of the correction" />
    <bpmn:endEvent id="the_session_closes_with_the_books_truthful" name="The session closes with the books truthful" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="a_recorded_figure_turns_out_wrong_or_a_plan_needs_adjusting" targetRef="name_the_entry_or_pick_from_the_last_ten_rows" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="name_the_entry_or_pick_from_the_last_ten_rows" targetRef="read_the_outcome_of_the_correction" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="read_the_outcome_of_the_correction" targetRef="the_session_closes_with_the_books_truthful" />
  </bpmn:process>
  <bpmn:process id="process_interactive_entry_editor">
    <bpmn:exclusiveGateway id="what_does_the_id_name" name="What does the id name?" />
    <bpmn:startEvent id="an_edit_request_arrives" name="An edit request arrives" />
    <bpmn:exclusiveGateway id="did_the_form_change_anything" name="Did the form change anything?" />
    <bpmn:userTask id="show_the_row_and_walk_the_pre_filled_form" name="Show the row and walk the pre-filled form" />
    <bpmn:exclusiveGateway id="does_the_edited_date_land_after_today" name="Does the edited date land after today?" />
    <bpmn:endEvent id="report_nothing_changed" name="Report nothing changed" />
    <bpmn:sendTask id="ask_the_ledger_to_journal_the_full_replacement" name="Ask the ledger to journal the full replacement" />
    <bpmn:receiveTask id="take_back_the_removal" name="Take back the removal" />
    <bpmn:sendTask id="ask_the_ledger_to_remove_the_row" name="Ask the ledger to remove the row" />
    <bpmn:sendTask id="ask_the_register_to_store_the_planned_replacement" name="Ask the register to store the planned replacement" />
    <bpmn:receiveTask id="take_back_the_register_s_answer" name="Take back the register's answer" />
    <bpmn:exclusiveGateway id="did_the_planned_entry_save" name="Did the planned entry save?" />
    <bpmn:endEvent id="report_the_move_to_a_plan" name="Report the move to a plan" />
    <bpmn:endEvent id="name_the_recovery" name="Name the recovery" />
    <bpmn:receiveTask id="take_back_the_applied_row_and_balances" name="Take back the applied row and balances" />
    <bpmn:endEvent id="report_the_corrected_row_and_balances" name="Report the corrected row and balances" />
    <bpmn:exclusiveGateway id="does_the_edited_date_land_today_or_earlier" name="Does the edited date land today or earlier?" />
    <bpmn:userTask id="show_the_plan_and_walk_the_pre_filled_form" name="Show the plan and walk the pre-filled form" />
    <bpmn:receiveTask id="take_back_the_booked_entry_and_balances" name="Take back the booked entry and balances" />
    <bpmn:sendTask id="ask_the_ledger_to_book_the_plan_as_it_stands" name="Ask the ledger to book the plan as it stands" />
    <bpmn:sendTask id="ask_the_register_to_strike_the_plan" name="Ask the register to strike the plan" />
    <bpmn:receiveTask id="take_back_the_register_s_strike" name="Take back the register's strike" />
    <bpmn:endEvent id="report_the_confirmed_plan" name="Report the confirmed plan" />
    <bpmn:receiveTask id="take_back_the_register_s_rewrite" name="Take back the register's rewrite" />
    <bpmn:sendTask id="ask_the_register_to_rewrite_the_plan_in_place" name="Ask the register to rewrite the plan in place" />
    <bpmn:endEvent id="report_the_rewritten_plan" name="Report the rewritten plan" />
    <bpmn:endEvent id="the_owner_editor_continues" name="The owner editor continues" />
    <bpmn:endEvent id="report_unknown_id" name="Report unknown id" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="an_edit_request_arrives" targetRef="what_does_the_id_name" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="show_the_row_and_walk_the_pre_filled_form" targetRef="did_the_form_change_anything" />
    <bpmn:sequenceFlow id="flow_6" name="Nothing changed" sourceRef="did_the_form_change_anything" targetRef="report_nothing_changed" />
    <bpmn:sequenceFlow id="flow_7" name="A change was recorded" sourceRef="did_the_form_change_anything" targetRef="does_the_edited_date_land_after_today" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="did_the_form_change_anything" targetRef="does_the_edited_date_land_after_today" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="ask_the_ledger_to_remove_the_row" targetRef="take_back_the_removal" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="take_back_the_removal" targetRef="ask_the_register_to_store_the_planned_replacement" />
    <bpmn:sequenceFlow id="flow_11" sourceRef="ask_the_register_to_store_the_planned_replacement" targetRef="take_back_the_register_s_answer" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="take_back_the_register_s_answer" targetRef="did_the_planned_entry_save" />
    <bpmn:sequenceFlow id="flow_13" name="No" sourceRef="did_the_planned_entry_save" targetRef="name_the_recovery" />
    <bpmn:sequenceFlow id="flow_14" name="Yes" sourceRef="did_the_planned_entry_save" targetRef="report_the_move_to_a_plan" />
    <bpmn:sequenceFlow id="flow_15" sourceRef="did_the_planned_entry_save" targetRef="report_the_move_to_a_plan" />
    <bpmn:sequenceFlow id="flow_16" name="Yes" sourceRef="does_the_edited_date_land_after_today" targetRef="ask_the_ledger_to_remove_the_row" />
    <bpmn:sequenceFlow id="flow_17" name="No" sourceRef="does_the_edited_date_land_after_today" targetRef="ask_the_ledger_to_journal_the_full_replacement" />
    <bpmn:sequenceFlow id="flow_18" sourceRef="does_the_edited_date_land_after_today" targetRef="ask_the_ledger_to_journal_the_full_replacement" />
    <bpmn:sequenceFlow id="flow_19" sourceRef="ask_the_ledger_to_journal_the_full_replacement" targetRef="take_back_the_applied_row_and_balances" />
    <bpmn:sequenceFlow id="flow_20" sourceRef="take_back_the_applied_row_and_balances" targetRef="report_the_corrected_row_and_balances" />
    <bpmn:sequenceFlow id="flow_21" name="A committed ledger row" sourceRef="what_does_the_id_name" targetRef="show_the_row_and_walk_the_pre_filled_form" />
    <bpmn:sequenceFlow id="flow_22" sourceRef="show_the_plan_and_walk_the_pre_filled_form" targetRef="does_the_edited_date_land_today_or_earlier" />
    <bpmn:sequenceFlow id="flow_23" sourceRef="ask_the_ledger_to_book_the_plan_as_it_stands" targetRef="take_back_the_booked_entry_and_balances" />
    <bpmn:sequenceFlow id="flow_24" sourceRef="take_back_the_booked_entry_and_balances" targetRef="ask_the_register_to_strike_the_plan" />
    <bpmn:sequenceFlow id="flow_25" sourceRef="ask_the_register_to_strike_the_plan" targetRef="take_back_the_register_s_strike" />
    <bpmn:sequenceFlow id="flow_26" sourceRef="take_back_the_register_s_strike" targetRef="report_the_confirmed_plan" />
    <bpmn:sequenceFlow id="flow_27" name="Yes" sourceRef="does_the_edited_date_land_today_or_earlier" targetRef="ask_the_ledger_to_book_the_plan_as_it_stands" />
    <bpmn:sequenceFlow id="flow_28" sourceRef="ask_the_register_to_rewrite_the_plan_in_place" targetRef="take_back_the_register_s_rewrite" />
    <bpmn:sequenceFlow id="flow_29" sourceRef="take_back_the_register_s_rewrite" targetRef="report_the_rewritten_plan" />
    <bpmn:sequenceFlow id="flow_30" name="No — still future" sourceRef="does_the_edited_date_land_today_or_earlier" targetRef="ask_the_register_to_rewrite_the_plan_in_place" />
    <bpmn:sequenceFlow id="flow_31" name="A planned entry" sourceRef="what_does_the_id_name" targetRef="show_the_plan_and_walk_the_pre_filled_form" />
    <bpmn:sequenceFlow id="flow_32" name="A group or rule instance" sourceRef="what_does_the_id_name" targetRef="the_owner_editor_continues" />
    <bpmn:sequenceFlow id="flow_33" name="Nothing resolvable" sourceRef="what_does_the_id_name" targetRef="report_unknown_id" />
  </bpmn:process>
  <bpmn:process id="process_journaled_ledger_engine">
    <bpmn:exclusiveGateway id="which_change" name="Which change?" />
    <bpmn:startEvent id="a_journaled_change_is_asked_for" name="A journaled change is asked for" />
    <bpmn:sendTask id="report_the_applied_row_and_balances" name="Report the applied row and balances" />
    <bpmn:serviceTask id="insert_the_replacement_at_its_new_date_and_rebalance" name="Insert the replacement at its new date and rebalance" />
    <bpmn:serviceTask id="remove_the_row_and_rebalance_the_later_days" name="Remove the row and rebalance the later days" />
    <bpmn:serviceTask id="remove_the_row_and_reverse_its_balance_effects" name="Remove the row and reverse its balance effects" />
    <bpmn:serviceTask id="book_the_plan_and_tie_it_to_the_retired_plan" name="Book the plan and tie it to the retired plan" />
    <bpmn:endEvent id="records_stand_corrected" name="Records stand corrected" />
    <bpmn:sequenceFlow id="flow_34" sourceRef="a_journaled_change_is_asked_for" targetRef="which_change" />
    <bpmn:sequenceFlow id="flow_35" sourceRef="remove_the_row_and_rebalance_the_later_days" targetRef="insert_the_replacement_at_its_new_date_and_rebalance" />
    <bpmn:sequenceFlow id="flow_36" sourceRef="insert_the_replacement_at_its_new_date_and_rebalance" targetRef="report_the_applied_row_and_balances" />
    <bpmn:sequenceFlow id="flow_37" name="A recorded row is replaced" sourceRef="which_change" targetRef="remove_the_row_and_rebalance_the_later_days" />
    <bpmn:sequenceFlow id="flow_38" sourceRef="remove_the_row_and_reverse_its_balance_effects" targetRef="report_the_applied_row_and_balances" />
    <bpmn:sequenceFlow id="flow_39" name="A moved row is removed" sourceRef="which_change" targetRef="remove_the_row_and_reverse_its_balance_effects" />
    <bpmn:sequenceFlow id="flow_40" sourceRef="book_the_plan_and_tie_it_to_the_retired_plan" targetRef="report_the_applied_row_and_balances" />
    <bpmn:sequenceFlow id="flow_41" name="A plan is booked" sourceRef="which_change" targetRef="book_the_plan_and_tie_it_to_the_retired_plan" />
    <bpmn:sequenceFlow id="flow_42" sourceRef="which_change" targetRef="report_the_applied_row_and_balances" />
    <bpmn:sequenceFlow id="flow_43" sourceRef="report_the_applied_row_and_balances" targetRef="records_stand_corrected" />
  </bpmn:process>
  <bpmn:process id="process_expected_register_store">
    <bpmn:exclusiveGateway id="which_change_2" name="Which change?" />
    <bpmn:startEvent id="a_register_change_is_asked_for" name="A register change is asked for" />
    <bpmn:sendTask id="report_the_register_s_answer" name="Report the register's answer" />
    <bpmn:serviceTask id="file_the_new_plan_in_the_register" name="File the new plan in the register" />
    <bpmn:serviceTask id="strike_the_confirmed_plan_from_the_register" name="Strike the confirmed plan from the register" />
    <bpmn:serviceTask id="rewrite_the_plan_s_stored_details" name="Rewrite the plan's stored details" />
    <bpmn:endEvent id="register_answered" name="Register answered" />
    <bpmn:sequenceFlow id="flow_44" sourceRef="a_register_change_is_asked_for" targetRef="which_change_2" />
    <bpmn:sequenceFlow id="flow_45" sourceRef="file_the_new_plan_in_the_register" targetRef="report_the_register_s_answer" />
    <bpmn:sequenceFlow id="flow_46" name="A moved row becomes a plan" sourceRef="which_change_2" targetRef="file_the_new_plan_in_the_register" />
    <bpmn:sequenceFlow id="flow_47" sourceRef="strike_the_confirmed_plan_from_the_register" targetRef="report_the_register_s_answer" />
    <bpmn:sequenceFlow id="flow_48" name="A confirmed plan must leave the register" sourceRef="which_change_2" targetRef="strike_the_confirmed_plan_from_the_register" />
    <bpmn:sequenceFlow id="flow_49" sourceRef="rewrite_the_plan_s_stored_details" targetRef="report_the_register_s_answer" />
    <bpmn:sequenceFlow id="flow_50" name="A still-future plan is rewritten" sourceRef="which_change_2" targetRef="rewrite_the_plan_s_stored_details" />
    <bpmn:sequenceFlow id="flow_51" sourceRef="which_change_2" targetRef="report_the_register_s_answer" />
    <bpmn:sequenceFlow id="flow_52" sourceRef="report_the_register_s_answer" targetRef="register_answered" />
  </bpmn:process>
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="participant_household_bookkeeper" name="household bookkeeper" processRef="process_household_bookkeeper" />
    <bpmn:participant id="participant_interactive_entry_editor" name="interactive entry editor" processRef="process_interactive_entry_editor" />
    <bpmn:participant id="participant_journaled_ledger_engine" name="journaled ledger engine" processRef="process_journaled_ledger_engine" />
    <bpmn:participant id="participant_expected_register_store" name="expected register store" processRef="process_expected_register_store" />
    <bpmn:messageFlow id="messageflow_53" name="Edit request" sourceRef="name_the_entry_or_pick_from_the_last_ten_rows" targetRef="an_edit_request_arrives" />
    <bpmn:messageFlow id="messageflow_54" name="Removal request" sourceRef="ask_the_ledger_to_remove_the_row" targetRef="a_journaled_change_is_asked_for" />
    <bpmn:messageFlow id="messageflow_55" name="Removal result" sourceRef="records_stand_corrected" targetRef="take_back_the_removal" />
    <bpmn:messageFlow id="messageflow_56" name="Plan-store request" sourceRef="ask_the_register_to_store_the_planned_replacement" targetRef="a_register_change_is_asked_for" />
    <bpmn:messageFlow id="messageflow_57" name="Plan-store result" sourceRef="register_answered" targetRef="take_back_the_register_s_answer" />
    <bpmn:messageFlow id="messageflow_58" name="Update request" sourceRef="ask_the_ledger_to_journal_the_full_replacement" targetRef="a_journaled_change_is_asked_for" />
    <bpmn:messageFlow id="messageflow_59" name="Update result" sourceRef="records_stand_corrected" targetRef="take_back_the_applied_row_and_balances" />
    <bpmn:messageFlow id="messageflow_60" name="Confirm request" sourceRef="ask_the_ledger_to_book_the_plan_as_it_stands" targetRef="a_journaled_change_is_asked_for" />
    <bpmn:messageFlow id="messageflow_61" name="Confirm result" sourceRef="records_stand_corrected" targetRef="take_back_the_booked_entry_and_balances" />
    <bpmn:messageFlow id="messageflow_62" name="Register strike request" sourceRef="ask_the_register_to_strike_the_plan" targetRef="a_register_change_is_asked_for" />
    <bpmn:messageFlow id="messageflow_63" name="Register strike result" sourceRef="register_answered" targetRef="take_back_the_register_s_strike" />
    <bpmn:messageFlow id="messageflow_64" name="Plan-rewrite request" sourceRef="ask_the_register_to_rewrite_the_plan_in_place" targetRef="a_register_change_is_asked_for" />
    <bpmn:messageFlow id="messageflow_65" name="Plan-rewrite result" sourceRef="register_answered" targetRef="take_back_the_register_s_rewrite" />
    <bpmn:messageFlow id="messageflow_66" name="Correction result" sourceRef="report_the_corrected_row_and_balances" targetRef="read_the_outcome_of_the_correction" />
    <bpmn:messageFlow id="messageflow_67" name="Move result" sourceRef="report_the_move_to_a_plan" targetRef="read_the_outcome_of_the_correction" />
    <bpmn:messageFlow id="messageflow_68" name="Recovery hint" sourceRef="name_the_recovery" targetRef="read_the_outcome_of_the_correction" />
    <bpmn:messageFlow id="messageflow_69" name="Nothing-changed result" sourceRef="report_nothing_changed" targetRef="read_the_outcome_of_the_correction" />
    <bpmn:messageFlow id="messageflow_70" name="Confirm result" sourceRef="report_the_confirmed_plan" targetRef="read_the_outcome_of_the_correction" />
    <bpmn:messageFlow id="messageflow_71" name="Rewrite result" sourceRef="report_the_rewritten_plan" targetRef="read_the_outcome_of_the_correction" />
    <bpmn:messageFlow id="messageflow_72" name="Unknown-id result" sourceRef="report_unknown_id" targetRef="read_the_outcome_of_the_correction" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="collaboration">
      <bpmndi:BPMNShape id="shape_participant_household_bookkeeper" bpmnElement="participant_household_bookkeeper" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2750" height="140" />
