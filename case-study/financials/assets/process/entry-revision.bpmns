process "household bookkeeper"
  start "A recorded figure turns out wrong or a plan needs adjusting"
  user "Name the entry or pick from the last ten rows"
  receive "Read the outcome of the correction"
  end "The session closes with the books truthful"

process "interactive entry editor"
  start "An edit request arrives"
  exclusive "What does the id name?"
    if "A committed ledger row" then
      user "Show the row and walk the pre-filled form"
      exclusive "Did the form change anything?"
        if "Nothing changed" then
          end "Report nothing changed"
        else "A change was recorded"
      exclusive "Does the edited date land after today?"
        if "Yes" then
          send "Ask the ledger to remove the row"
          receive "Take back the removal"
          send "Ask the register to store the planned replacement"
          receive "Take back the register's answer"
          exclusive "Did the planned entry save?"
            if "No" then
              end "Name the recovery"
            else "Yes"
          end "Report the move to a plan"
        else "No"
      send "Ask the ledger to journal the full replacement"
      receive "Take back the applied row and balances"
      end "Report the corrected row and balances"
    if "A planned entry" then
      user "Show the plan and walk the pre-filled form"
      exclusive "Does the edited date land today or earlier?"
        if "Yes" then
          send "Ask the ledger to book the plan as it stands"
          receive "Take back the booked entry and balances"
          send "Ask the register to strike the plan"
          receive "Take back the register's strike"
          end "Report the confirmed plan"
        else "No — still future"
          send "Ask the register to rewrite the plan in place"
          receive "Take back the register's rewrite"
          end "Report the rewritten plan"
    if "A group or rule instance" then
      end "The owner editor continues"
    else "Nothing resolvable"
      end "Report unknown id"

process "journaled ledger engine"
  start "A journaled change is asked for"
  exclusive "Which change?"
    if "A recorded row is replaced" then
      service "Remove the row and rebalance the later days"
      service "Insert the replacement at its new date and rebalance"
    if "A moved row is removed" then
      service "Remove the row and reverse its balance effects"
    else "A plan is booked"
      service "Book the plan and tie it to the retired plan"
  send "Report the applied row and balances"
  end "Records stand corrected"

process "expected register store"
  start "A register change is asked for"
  exclusive "Which change?"
    if "A moved row becomes a plan" then
      service "File the new plan in the register"
    if "A confirmed plan must leave the register" then
      service "Strike the confirmed plan from the register"
    else "A still-future plan is rewritten"
      service "Rewrite the plan's stored details"
  send "Report the register's answer"
  end "Register answered"

message flows
  from "household bookkeeper"."Name the entry or pick from the last ten rows" to "interactive entry editor"."An edit request arrives" label "Edit request"
  from "interactive entry editor"."Ask the ledger to remove the row" to "journaled ledger engine"."A journaled change is asked for" label "Removal request"
  from "journaled ledger engine"."Records stand corrected" to "interactive entry editor"."Take back the removal" label "Removal result"
  from "interactive entry editor"."Ask the register to store the planned replacement" to "expected register store"."A register change is asked for" label "Plan-store request"
  from "expected register store"."Register answered" to "interactive entry editor"."Take back the register's answer" label "Plan-store result"
  from "interactive entry editor"."Ask the ledger to journal the full replacement" to "journaled ledger engine"."A journaled change is asked for" label "Update request"
  from "journaled ledger engine"."Records stand corrected" to "interactive entry editor"."Take back the applied row and balances" label "Update result"
  from "interactive entry editor"."Ask the ledger to book the plan as it stands" to "journaled ledger engine"."A journaled change is asked for" label "Confirm request"
  from "journaled ledger engine"."Records stand corrected" to "interactive entry editor"."Take back the booked entry and balances" label "Confirm result"
  from "interactive entry editor"."Ask the register to strike the plan" to "expected register store"."A register change is asked for" label "Register strike request"
  from "expected register store"."Register answered" to "interactive entry editor"."Take back the register's strike" label "Register strike result"
  from "interactive entry editor"."Ask the register to rewrite the plan in place" to "expected register store"."A register change is asked for" label "Plan-rewrite request"
  from "expected register store"."Register answered" to "interactive entry editor"."Take back the register's rewrite" label "Plan-rewrite result"
  from "interactive entry editor"."Report the corrected row and balances" to "household bookkeeper"."Read the outcome of the correction" label "Correction result"
  from "interactive entry editor"."Report the move to a plan" to "household bookkeeper"."Read the outcome of the correction" label "Move result"
  from "interactive entry editor"."Name the recovery" to "household bookkeeper"."Read the outcome of the correction" label "Recovery hint"
  from "interactive entry editor"."Report nothing changed" to "household bookkeeper"."Read the outcome of the correction" label "Nothing-changed result"
  from "interactive entry editor"."Report the confirmed plan" to "household bookkeeper"."Read the outcome of the correction" label "Confirm result"
  from "interactive entry editor"."Report the rewritten plan" to "household bookkeeper"."Read the outcome of the correction" label "Rewrite result"
  from "interactive entry editor"."Report unknown id" to "household bookkeeper"."Read the outcome of the correction" label "Unknown-id result"

