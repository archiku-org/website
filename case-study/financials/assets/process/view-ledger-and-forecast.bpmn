<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="definitions" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:process id="process_owner">
    <bpmn:exclusiveGateway id="which_window_on_the_money" name="Which window on the money?" />
    <bpmn:startEvent id="the_owner_wants_to_see_where_the_money_stands" name="The owner wants to see where the money stands" />
    <bpmn:endEvent id="the_picture_is_taken_in" name="The picture is taken in" />
    <bpmn:receiveTask id="read_the_printed_snapshot" name="Read the printed snapshot" />
    <bpmn:sendTask id="ask_for_the_printed_ledger" name="Ask for the printed ledger" />
    <bpmn:receiveTask id="use_the_interactive_view" name="Use the interactive view" />
    <bpmn:sendTask id="open_the_interactive_ledger" name="Open the interactive ledger" />
    <bpmn:receiveTask id="read_the_retrospective" name="Read the retrospective" />
    <bpmn:sendTask id="ask_for_the_monthly_report" name="Ask for the monthly report" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="the_owner_wants_to_see_where_the_money_stands" targetRef="which_window_on_the_money" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="ask_for_the_printed_ledger" targetRef="read_the_printed_snapshot" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="read_the_printed_snapshot" targetRef="the_picture_is_taken_in" />
    <bpmn:sequenceFlow id="flow_4" name="A quick printed snapshot" sourceRef="which_window_on_the_money" targetRef="ask_for_the_printed_ledger" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="open_the_interactive_ledger" targetRef="use_the_interactive_view" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="use_the_interactive_view" targetRef="the_picture_is_taken_in" />
    <bpmn:sequenceFlow id="flow_7" name="An interactive browse" sourceRef="which_window_on_the_money" targetRef="open_the_interactive_ledger" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="ask_for_the_monthly_report" targetRef="read_the_retrospective" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="read_the_retrospective" targetRef="the_picture_is_taken_in" />
    <bpmn:sequenceFlow id="flow_10" name="A monthly retrospective" sourceRef="which_window_on_the_money" targetRef="ask_for_the_monthly_report" />
    <bpmn:sequenceFlow id="flow_11" sourceRef="which_window_on_the_money" targetRef="the_picture_is_taken_in" />
  </bpmn:process>
  <bpmn:process id="process_ledger_composition">
    <bpmn:serviceTask id="boot_the_committed_ledger_from_the_journal" name="Boot the committed ledger from the journal" />
    <bpmn:startEvent id="receive_a_view_s_request" name="Receive a view's request" />
    <bpmn:serviceTask id="expand_the_approved_recurring_rules_over_the_window" name="Expand the approved recurring rules over the window" />
    <bpmn:serviceTask id="drop_predictions_a_real_entry_already_covers" name="Drop predictions a real entry already covers" />
    <bpmn:serviceTask id="split_what_landed_but_is_unconfirmed_from_what_is_still_ahead" name="Split what landed but is unconfirmed from what is still ahead" />
    <bpmn:serviceTask id="walk_the_running_balance_through_every_row" name="Walk the running balance through every row" />
    <bpmn:serviceTask id="collapse_fully_committed_groups_into_one_total_row" name="Collapse fully committed groups into one total row" />
    <bpmn:serviceTask id="warn_where_an_account_is_predicted_to_dip_below_zero" name="Warn where an account is predicted to dip below zero" />
    <bpmn:endEvent id="the_money_picture_is_composed" name="The money picture is composed" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="receive_a_view_s_request" targetRef="boot_the_committed_ledger_from_the_journal" />
    <bpmn:sequenceFlow id="flow_13" sourceRef="boot_the_committed_ledger_from_the_journal" targetRef="expand_the_approved_recurring_rules_over_the_window" />
    <bpmn:sequenceFlow id="flow_14" sourceRef="expand_the_approved_recurring_rules_over_the_window" targetRef="drop_predictions_a_real_entry_already_covers" />
    <bpmn:sequenceFlow id="flow_15" sourceRef="drop_predictions_a_real_entry_already_covers" targetRef="split_what_landed_but_is_unconfirmed_from_what_is_still_ahead" />
    <bpmn:sequenceFlow id="flow_16" sourceRef="split_what_landed_but_is_unconfirmed_from_what_is_still_ahead" targetRef="walk_the_running_balance_through_every_row" />
    <bpmn:sequenceFlow id="flow_17" sourceRef="walk_the_running_balance_through_every_row" targetRef="collapse_fully_committed_groups_into_one_total_row" />
    <bpmn:sequenceFlow id="flow_18" sourceRef="collapse_fully_committed_groups_into_one_total_row" targetRef="warn_where_an_account_is_predicted_to_dip_below_zero" />
    <bpmn:sequenceFlow id="flow_19" sourceRef="warn_where_an_account_is_predicted_to_dip_below_zero" targetRef="the_money_picture_is_composed" />
  </bpmn:process>
  <bpmn:process id="process_ledger_list_window">
    <bpmn:task id="print_the_booked_rows_the_open_entries_and_the_projection" name="Print the booked rows, the open entries and the projection" />
    <bpmn:startEvent id="receive_the_composed_picture_for_printing" name="Receive the composed picture for printing" />
    <bpmn:endEvent id="snapshot_printed" name="Snapshot printed" />
    <bpmn:sequenceFlow id="flow_20" sourceRef="receive_the_composed_picture_for_printing" targetRef="print_the_booked_rows_the_open_entries_and_the_projection" />
    <bpmn:sequenceFlow id="flow_21" sourceRef="print_the_booked_rows_the_open_entries_and_the_projection" targetRef="snapshot_printed" />
  </bpmn:process>
  <bpmn:process id="process_interactive_ledger">
    <bpmn:task id="show_the_history_the_open_entries_and_the_projection_to_year_end" name="Show the history, the open entries and the projection to year end" />
    <bpmn:startEvent id="receive_the_composed_picture_for_the_view" name="Receive the composed picture for the view" />
    <bpmn:exclusiveGateway id="what_does_the_owner_do_next" name="What does the owner do next?" />
    <bpmn:endEvent id="browse_closed" name="Browse closed" />
    <bpmn:task id="read_the_row_s_full_detail_dialog" name="Read the row's full detail dialog" />
    <bpmn:task id="re_land_the_view_on_the_newly_added_row" name="Re-land the view on the newly added row" />
    <bpmn:task id="fill_in_the_add_dialog_and_save" name="Fill in the add dialog and save" />
    <bpmn:sequenceFlow id="flow_22" sourceRef="receive_the_composed_picture_for_the_view" targetRef="show_the_history_the_open_entries_and_the_projection_to_year_end" />
    <bpmn:sequenceFlow id="flow_23" sourceRef="show_the_history_the_open_entries_and_the_projection_to_year_end" targetRef="what_does_the_owner_do_next" />
    <bpmn:sequenceFlow id="flow_24" sourceRef="read_the_row_s_full_detail_dialog" targetRef="what_does_the_owner_do_next" />
    <bpmn:sequenceFlow id="flow_25" name="Open a row's details" sourceRef="what_does_the_owner_do_next" targetRef="read_the_row_s_full_detail_dialog" />
    <bpmn:sequenceFlow id="flow_26" sourceRef="fill_in_the_add_dialog_and_save" targetRef="re_land_the_view_on_the_newly_added_row" />
    <bpmn:sequenceFlow id="flow_27" sourceRef="re_land_the_view_on_the_newly_added_row" targetRef="what_does_the_owner_do_next" />
    <bpmn:sequenceFlow id="flow_28" name="Add a new movement" sourceRef="what_does_the_owner_do_next" targetRef="fill_in_the_add_dialog_and_save" />
    <bpmn:sequenceFlow id="flow_29" name="Done looking" sourceRef="what_does_the_owner_do_next" targetRef="browse_closed" />
    <bpmn:sequenceFlow id="flow_30" sourceRef="what_does_the_owner_do_next" targetRef="browse_closed" />
  </bpmn:process>
  <bpmn:process id="process_monthly_report">
    <bpmn:task id="select_only_the_booked_entries_in_scope" name="Select only the booked entries in scope" />
    <bpmn:startEvent id="receive_the_composed_picture_for_the_report" name="Receive the composed picture for the report" />
    <bpmn:task id="sum_the_monthly_flows_and_the_category_totals" name="Sum the monthly flows and the category totals" />
    <bpmn:task id="draw_the_balance_curve_across_months" name="Draw the balance curve across months" />
    <bpmn:endEvent id="report_printed" name="Report printed" />
    <bpmn:sequenceFlow id="flow_31" sourceRef="receive_the_composed_picture_for_the_report" targetRef="select_only_the_booked_entries_in_scope" />
    <bpmn:sequenceFlow id="flow_32" sourceRef="select_only_the_booked_entries_in_scope" targetRef="sum_the_monthly_flows_and_the_category_totals" />
    <bpmn:sequenceFlow id="flow_33" sourceRef="sum_the_monthly_flows_and_the_category_totals" targetRef="draw_the_balance_curve_across_months" />
    <bpmn:sequenceFlow id="flow_34" sourceRef="draw_the_balance_curve_across_months" targetRef="report_printed" />
  </bpmn:process>
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="participant_owner" name="Owner" processRef="process_owner" />
    <bpmn:participant id="participant_ledger_composition" name="Ledger composition" processRef="process_ledger_composition" />
    <bpmn:participant id="participant_ledger_list_window" name="Ledger list window" processRef="process_ledger_list_window" />
    <bpmn:participant id="participant_interactive_ledger" name="Interactive ledger" processRef="process_interactive_ledger" />
    <bpmn:participant id="participant_monthly_report" name="Monthly report" processRef="process_monthly_report" />
    <bpmn:messageFlow id="messageflow_35" name="Ledger request" sourceRef="ask_for_the_printed_ledger" targetRef="receive_a_view_s_request" />
    <bpmn:messageFlow id="messageflow_36" name="View request" sourceRef="open_the_interactive_ledger" targetRef="receive_a_view_s_request" />
    <bpmn:messageFlow id="messageflow_37" name="Report request" sourceRef="ask_for_the_monthly_report" targetRef="receive_a_view_s_request" />
    <bpmn:messageFlow id="messageflow_38" name="Composed picture" sourceRef="the_money_picture_is_composed" targetRef="receive_the_composed_picture_for_printing" />
    <bpmn:messageFlow id="messageflow_39" name="Composed picture" sourceRef="the_money_picture_is_composed" targetRef="receive_the_composed_picture_for_the_view" />
    <bpmn:messageFlow id="messageflow_40" name="Composed picture" sourceRef="the_money_picture_is_composed" targetRef="receive_the_composed_picture_for_the_report" />
    <bpmn:messageFlow id="messageflow_41" name="Printed snapshot" sourceRef="snapshot_printed" targetRef="read_the_printed_snapshot" />
    <bpmn:messageFlow id="messageflow_42" name="View closed" sourceRef="browse_closed" targetRef="use_the_interactive_view" />
    <bpmn:messageFlow id="messageflow_43" name="Report ready" sourceRef="report_printed" targetRef="read_the_retrospective" />
  </bpmn:collaboration>
