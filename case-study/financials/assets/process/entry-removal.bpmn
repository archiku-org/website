    <bpmn:sequenceFlow id="flow_33" name="A planned entry" sourceRef="which_store_owns_the_id_2" targetRef="show_the_planned_entry_and_require_the_typed_affirmative" />
    <bpmn:sequenceFlow id="flow_34" sourceRef="dissolve_only_the_grouping_member_rows_untouched" targetRef="dissolve_receipt" />
