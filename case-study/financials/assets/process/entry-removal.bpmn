<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="definitions" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:process id="process_household_bookkeeper">
    <bpmn:userTask id="open_the_delete_command_with_the_row_s_id_or_bare_to_pick_from_the_last_ten_past_rows" name="Open the delete command with the row's id, or bare to pick from the last ten past rows" />
    <bpmn:startEvent id="an_entry_turns_out_not_to_belong_in_the_books" name="An entry turns out not to belong in the books" />
    <bpmn:exclusiveGateway id="which_store_owns_the_id" name="Which store owns the id?" />
    <bpmn:endEvent id="the_books_no_longer_carry_the_entry_the_journal_proves_what_was_removed" name="The books no longer carry the entry; the journal proves what was removed" />
    <bpmn:sendTask id="removal_request_with_the_row_s_id" name="Removal request with the row's id" />
    <bpmn:userTask id="show_the_row_and_type_an_affirmative_to_confirm_the_removal" name="Show the row and type an affirmative to confirm the removal" />
    <bpmn:receiveTask id="removal_receipt_the_transaction_is_gone_the_journal_holds_its_full_pre_image" name="Removal receipt — the transaction is gone, the journal holds its full pre-image" />
    <bpmn:userTask id="check_the_ledger_listing_when_the_removed_row_was_a_transfer" name="Check the ledger listing when the removed row was a transfer" />
    <bpmn:sendTask id="striking_request_with_the_plan_s_id" name="Striking request with the plan's id" />
    <bpmn:userTask id="show_the_planned_entry_and_type_an_affirmative_to_confirm_the_striking" name="Show the planned entry and type an affirmative to confirm the striking" />
    <bpmn:receiveTask id="striking_receipt_the_plan_leaves_the_register_no_history_written" name="Striking receipt — the plan leaves the register, no history written" />
    <bpmn:sendTask id="dissolve_request_with_the_group_s_id" name="Dissolve request with the group's id" />
    <bpmn:userTask id="show_the_group_and_confirm_the_dissolve" name="Show the group and confirm the dissolve" />
    <bpmn:receiveTask id="dissolve_receipt_the_bundle_is_gone_the_member_rows_keep_existing" name="Dissolve receipt — the bundle is gone, the member rows keep existing" />
    <bpmn:sendTask id="suppression_request_with_the_occurrence_s_id" name="Suppression request with the occurrence's id" />
    <bpmn:userTask id="show_the_projected_occurrence_and_confirm_the_suppression" name="Show the projected occurrence and confirm the suppression" />
    <bpmn:receiveTask id="suppression_receipt_the_occurrence_leaves_the_forecast_the_rule_keeps_running" name="Suppression receipt — the occurrence leaves the forecast, the rule keeps running" />
    <bpmn:userTask id="hear_that_the_id_matches_nothing_and_leave_the_books_untouched" name="Hear that the id matches nothing and leave the books untouched" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="an_entry_turns_out_not_to_belong_in_the_books" targetRef="open_the_delete_command_with_the_row_s_id_or_bare_to_pick_from_the_last_ten_past_rows" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="open_the_delete_command_with_the_row_s_id_or_bare_to_pick_from_the_last_ten_past_rows" targetRef="which_store_owns_the_id" />
