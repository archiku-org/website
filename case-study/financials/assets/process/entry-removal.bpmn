  <bpmn:process id="process_recurrence_engine">
    <bpmn:task id="match_the_occurrence_to_its_rule_and_check_the_rule_s_exceptions" name="Match the occurrence to its rule and check the rule's exceptions" />
    <bpmn:startEvent id="a_suppression_request_arrives_for_a_projected_occurrence" name="A suppression request arrives for a projected occurrence" />
    <bpmn:exclusiveGateway id="already_suppressed" name="Already suppressed?" />
    <bpmn:endEvent id="nothing_more_changes" name="Nothing more changes" />
    <bpmn:userTask id="report_that_nothing_more_will_change" name="Report that nothing more will change" />
    <bpmn:sendTask id="suppression_receipt" name="Suppression receipt" />
    <bpmn:task id="require_the_typed_affirmative_and_add_the_occurrence_date_to_the_rule_s_exceptions" name="Require the typed affirmative and add the occurrence date to the rule's exceptions" />
    <bpmn:endEvent id="occurrence_suppressed_the_rule_keeps_running_for_the_other_periods" name="Occurrence suppressed — the rule keeps running for the other periods" />
    <bpmn:sequenceFlow id="flow_41" sourceRef="a_suppression_request_arrives_for_a_projected_occurrence" targetRef="match_the_occurrence_to_its_rule_and_check_the_rule_s_exceptions" />
