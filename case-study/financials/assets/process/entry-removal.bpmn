    <bpmn:sequenceFlow id="flow_7" name="A committed transaction" sourceRef="which_store_owns_the_id" targetRef="show_the_row_and_type_an_affirmative_to_confirm_the_removal" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="show_the_planned_entry_and_type_an_affirmative_to_confirm_the_striking" targetRef="striking_request_with_the_plan_s_id" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="striking_request_with_the_plan_s_id" targetRef="striking_receipt_the_plan_leaves_the_register_no_history_written" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="striking_receipt_the_plan_leaves_the_register_no_history_written" targetRef="the_books_no_longer_carry_the_entry_the_journal_proves_what_was_removed" />
    <bpmn:sequenceFlow id="flow_11" name="A planned entry" sourceRef="which_store_owns_the_id" targetRef="show_the_planned_entry_and_type_an_affirmative_to_confirm_the_striking" />
