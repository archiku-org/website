    <bpmn:sequenceFlow id="flow_43" sourceRef="report_that_nothing_more_will_change" targetRef="nothing_more_changes" />
    <bpmn:sequenceFlow id="flow_44" name="Yes" sourceRef="already_suppressed" targetRef="report_that_nothing_more_will_change" />
    <bpmn:sequenceFlow id="flow_45" sourceRef="require_the_typed_affirmative_and_add_the_occurrence_date_to_the_rule_s_exceptions" targetRef="suppression_receipt" />
    <bpmn:sequenceFlow id="flow_46" sourceRef="suppression_receipt" targetRef="occurrence_suppressed_the_rule_keeps_running_for_the_other_periods" />
    <bpmn:sequenceFlow id="flow_47" name="No" sourceRef="already_suppressed" targetRef="require_the_typed_affirmative_and_add_the_occurrence_date_to_the_rule_s_exceptions" />
  </bpmn:process>
  <bpmn:process id="process_journaled_ledger_engine">
    <bpmn:task id="read_the_live_entry_for_the_target_id_and_refuse_when_it_is_not_there" name="Read the live entry for the target id and refuse when it is not there" />
    <bpmn:startEvent id="a_removal_carrying_the_victim_s_pre_image_arrives" name="A removal carrying the victim's pre-image arrives" />
    <bpmn:task id="append_the_content_hashed_removal_record_and_fold_it_onto_the_books" name="Append the content-hashed removal record and fold it onto the books" />
    <bpmn:exclusiveGateway id="does_the_stored_pre_image_match_the_live_entry_at_replay" name="Does the stored pre-image match the live entry at replay?" />
    <bpmn:endEvent id="the_removal_is_refused_the_journal_waits_for_repair" name="The removal is refused — the journal waits for repair" />
    <bpmn:task id="refuse_loudly_the_books_will_not_open_until_the_journal_is_repaired" name="Refuse loudly — the books will not open until the journal is repaired" />
    <bpmn:sendTask id="removal_applied_receipt_back_to_the_dispatcher" name="Removal applied — receipt back to the dispatcher" />
    <bpmn:task id="splice_the_entry_out_and_re_propagate_the_running_balances_into_every_later_row" name="Splice the entry out and re-propagate the running balances into every later row" />
    <bpmn:endEvent id="the_removal_is_durable_replayable_and_balance_correct" name="The removal is durable, replayable and balance-correct" />
    <bpmn:sequenceFlow id="flow_48" sourceRef="a_removal_carrying_the_victim_s_pre_image_arrives" targetRef="read_the_live_entry_for_the_target_id_and_refuse_when_it_is_not_there" />
    <bpmn:sequenceFlow id="flow_49" sourceRef="read_the_live_entry_for_the_target_id_and_refuse_when_it_is_not_there" targetRef="append_the_content_hashed_removal_record_and_fold_it_onto_the_books" />
    <bpmn:sequenceFlow id="flow_50" sourceRef="append_the_content_hashed_removal_record_and_fold_it_onto_the_books" targetRef="does_the_stored_pre_image_match_the_live_entry_at_replay" />
    <bpmn:sequenceFlow id="flow_51" sourceRef="refuse_loudly_the_books_will_not_open_until_the_journal_is_repaired" targetRef="the_removal_is_refused_the_journal_waits_for_repair" />
    <bpmn:sequenceFlow id="flow_52" name="No" sourceRef="does_the_stored_pre_image_match_the_live_entry_at_replay" targetRef="refuse_loudly_the_books_will_not_open_until_the_journal_is_repaired" />
    <bpmn:sequenceFlow id="flow_53" sourceRef="splice_the_entry_out_and_re_propagate_the_running_balances_into_every_later_row" targetRef="removal_applied_receipt_back_to_the_dispatcher" />
    <bpmn:sequenceFlow id="flow_54" sourceRef="removal_applied_receipt_back_to_the_dispatcher" targetRef="the_removal_is_durable_replayable_and_balance_correct" />
    <bpmn:sequenceFlow id="flow_55" name="Yes" sourceRef="does_the_stored_pre_image_match_the_live_entry_at_replay" targetRef="splice_the_entry_out_and_re_propagate_the_running_balances_into_every_later_row" />
  </bpmn:process>
  <bpmn:collaboration id="collaboration">
