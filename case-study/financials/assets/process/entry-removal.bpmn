    <bpmn:sequenceFlow id="flow_13" sourceRef="dissolve_request_with_the_group_s_id" targetRef="dissolve_receipt_the_bundle_is_gone_the_member_rows_keep_existing" />
    <bpmn:sequenceFlow id="flow_14" sourceRef="dissolve_receipt_the_bundle_is_gone_the_member_rows_keep_existing" targetRef="the_books_no_longer_carry_the_entry_the_journal_proves_what_was_removed" />
    <bpmn:sequenceFlow id="flow_15" name="A group id" sourceRef="which_store_owns_the_id" targetRef="show_the_group_and_confirm_the_dissolve" />
    <bpmn:sequenceFlow id="flow_16" sourceRef="show_the_projected_occurrence_and_confirm_the_suppression" targetRef="suppression_request_with_the_occurrence_s_id" />
    <bpmn:sequenceFlow id="flow_17" sourceRef="suppression_request_with_the_occurrence_s_id" targetRef="suppression_receipt_the_occurrence_leaves_the_forecast_the_rule_keeps_running" />
    <bpmn:sequenceFlow id="flow_18" sourceRef="suppression_receipt_the_occurrence_leaves_the_forecast_the_rule_keeps_running" targetRef="the_books_no_longer_carry_the_entry_the_journal_proves_what_was_removed" />
    <bpmn:sequenceFlow id="flow_19" name="A rule-instance id" sourceRef="which_store_owns_the_id" targetRef="show_the_projected_occurrence_and_confirm_the_suppression" />
    <bpmn:sequenceFlow id="flow_20" sourceRef="hear_that_the_id_matches_nothing_and_leave_the_books_untouched" targetRef="the_books_no_longer_carry_the_entry_the_journal_proves_what_was_removed" />
    <bpmn:sequenceFlow id="flow_21" name="Unknown id" sourceRef="which_store_owns_the_id" targetRef="hear_that_the_id_matches_nothing_and_leave_the_books_untouched" />
    <bpmn:sequenceFlow id="flow_22" sourceRef="which_store_owns_the_id" targetRef="the_books_no_longer_carry_the_entry_the_journal_proves_what_was_removed" />
  </bpmn:process>
  <bpmn:process id="process_interactive_deletion_dispatcher">
    <bpmn:task id="resolve_the_typed_id_against_the_committed_books" name="Resolve the typed id against the committed books" />
    <bpmn:startEvent id="a_removal_request_arrives" name="A removal request arrives" />
    <bpmn:exclusiveGateway id="which_store_owns_the_id_2" name="Which store owns the id?" />
    <bpmn:serviceTask id="snapshot_the_entry_s_full_content_from_the_live_books" name="Snapshot the entry's full content from the live books" />
    <bpmn:task id="show_the_row_and_require_the_typed_affirmative" name="Show the row and require the typed affirmative" />
    <bpmn:serviceTask id="journal_the_removal_with_the_pre_image_snapshot_and_re_propagate_the_balances" name="Journal the removal with the pre-image snapshot and re-propagate the balances" />
    <bpmn:sendTask id="removal_receipt_with_the_transfer_warning_when_the_category_was_a_transfer" name="Removal receipt — with the transfer warning when the category was a transfer" />
    <bpmn:endEvent id="transaction_removed_the_journal_proves_the_removal" name="Transaction removed — the journal proves the removal" />
    <bpmn:task id="strike_the_planned_entry_from_its_register" name="Strike the planned entry from its register" />
    <bpmn:task id="show_the_planned_entry_and_require_the_typed_affirmative" name="Show the planned entry and require the typed affirmative" />
    <bpmn:sendTask id="striking_receipt" name="Striking receipt" />
    <bpmn:endEvent id="planned_entry_struck_nothing_journaled" name="Planned entry struck — nothing journaled" />
    <bpmn:sendTask id="dissolve_receipt" name="Dissolve receipt" />
    <bpmn:task id="dissolve_only_the_grouping_member_rows_untouched" name="Dissolve only the grouping, member rows untouched" />
    <bpmn:endEvent id="group_dissolved_member_rows_keep_existing" name="Group dissolved — member rows keep existing" />
    <bpmn:endEvent id="occurrence_handed_to_the_rule_s_engine" name="Occurrence handed to the rule's engine" />
    <bpmn:sendTask id="suppression_request_with_the_occurrence_s_id_2" name="Suppression request with the occurrence's id" />
    <bpmn:endEvent id="nothing_removed" name="Nothing removed" />
    <bpmn:task id="report_that_the_id_matches_nothing" name="Report that the id matches nothing" />
