<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="definitions" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:process id="process_owner">
    <bpmn:exclusiveGateway id="how_is_it_stated" name="How is it stated?" />
    <bpmn:startEvent id="an_upcoming_movement_becomes_known" name="An upcoming movement becomes known" />
    <bpmn:receiveTask id="read_the_outcome" name="Read the outcome" />
    <bpmn:userTask id="state_the_movement_ahead_of_today" name="State the movement ahead of today" />
    <bpmn:userTask id="register_the_expectation_directly" name="Register the expectation directly" />
    <bpmn:endEvent id="expectation_held_visibly_in_the_forecast" name="Expectation held visibly in the forecast" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="an_upcoming_movement_becomes_known" targetRef="how_is_it_stated" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="state_the_movement_ahead_of_today" targetRef="read_the_outcome" />
    <bpmn:sequenceFlow id="flow_3" name="Piecewise or quick-shorthand" sourceRef="how_is_it_stated" targetRef="state_the_movement_ahead_of_today" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="register_the_expectation_directly" targetRef="read_the_outcome" />
    <bpmn:sequenceFlow id="flow_5" name="The expect door, stated in full" sourceRef="how_is_it_stated" targetRef="register_the_expectation_directly" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="how_is_it_stated" targetRef="read_the_outcome" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="read_the_outcome" targetRef="expectation_held_visibly_in_the_forecast" />
  </bpmn:process>
  <bpmn:process id="process_entry_intake">
    <bpmn:exclusiveGateway id="stated_for_a_day_ahead" name="Stated for a day ahead?" />
    <bpmn:startEvent id="statement_arrives" name="Statement arrives" />
    <bpmn:endEvent id="statement_handed_onward" name="Statement handed onward" />
    <bpmn:sendTask id="hand_the_promise_to_the_register" name="Hand the promise to the register" />
    <bpmn:endEvent id="left_to_the_actual_ledger" name="Left to the actual ledger" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="statement_arrives" targetRef="stated_for_a_day_ahead" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="hand_the_promise_to_the_register" targetRef="statement_handed_onward" />
    <bpmn:sequenceFlow id="flow_10" name="Yes" sourceRef="stated_for_a_day_ahead" targetRef="hand_the_promise_to_the_register" />
    <bpmn:sequenceFlow id="flow_11" name="Already today or past" sourceRef="stated_for_a_day_ahead" targetRef="left_to_the_actual_ledger" />
  </bpmn:process>
  <bpmn:process id="process_expected_register">
    <bpmn:businessRuleTask id="check_the_promise_statement" name="Check the promise statement" />
    <bpmn:startEvent id="promise_arrives" name="Promise arrives" />
    <bpmn:exclusiveGateway id="does_the_statement_hold" name="Does the statement hold?" />
    <bpmn:serviceTask id="assign_the_register_id" name="Assign the register id" />
    <bpmn:endEvent id="promise_refused" name="Promise refused" />
    <bpmn:sendTask id="refuse_with_the_reason" name="Refuse with the reason" />
    <bpmn:exclusiveGateway id="was_this_a_rehearsal" name="Was this a rehearsal?" />
    <bpmn:serviceTask id="park_the_promise_in_the_register" name="Park the promise in the register" />
    <bpmn:endEvent id="nothing_stored" name="Nothing stored" />
    <bpmn:sendTask id="preview_what_would_be_stored" name="Preview what would be stored" />
    <bpmn:endEvent id="promise_parked" name="Promise parked" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="promise_arrives" targetRef="check_the_promise_statement" />
    <bpmn:sequenceFlow id="flow_13" sourceRef="check_the_promise_statement" targetRef="does_the_statement_hold" />
    <bpmn:sequenceFlow id="flow_14" sourceRef="refuse_with_the_reason" targetRef="promise_refused" />
    <bpmn:sequenceFlow id="flow_15" name="No" sourceRef="does_the_statement_hold" targetRef="refuse_with_the_reason" />
    <bpmn:sequenceFlow id="flow_16" name="Yes" sourceRef="does_the_statement_hold" targetRef="assign_the_register_id" />
    <bpmn:sequenceFlow id="flow_17" sourceRef="does_the_statement_hold" targetRef="assign_the_register_id" />
    <bpmn:sequenceFlow id="flow_18" sourceRef="assign_the_register_id" targetRef="was_this_a_rehearsal" />
    <bpmn:sequenceFlow id="flow_19" sourceRef="preview_what_would_be_stored" targetRef="nothing_stored" />
    <bpmn:sequenceFlow id="flow_20" name="Rehearsal, store nothing" sourceRef="was_this_a_rehearsal" targetRef="preview_what_would_be_stored" />
    <bpmn:sequenceFlow id="flow_21" name="Real registration" sourceRef="was_this_a_rehearsal" targetRef="park_the_promise_in_the_register" />
    <bpmn:sequenceFlow id="flow_22" sourceRef="was_this_a_rehearsal" targetRef="park_the_promise_in_the_register" />
    <bpmn:sequenceFlow id="flow_23" sourceRef="park_the_promise_in_the_register" targetRef="promise_parked" />
  </bpmn:process>
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="participant_owner" name="Owner" processRef="process_owner" />
    <bpmn:participant id="participant_entry_intake" name="Entry intake" processRef="process_entry_intake" />
    <bpmn:participant id="participant_expected_register" name="Expected register" processRef="process_expected_register" />
    <bpmn:messageFlow id="messageflow_24" name="Movement statement" sourceRef="state_the_movement_ahead_of_today" targetRef="statement_arrives" />
    <bpmn:messageFlow id="messageflow_25" name="Expectation statement" sourceRef="register_the_expectation_directly" targetRef="promise_arrives" />
    <bpmn:messageFlow id="messageflow_26" name="Promise request" sourceRef="hand_the_promise_to_the_register" targetRef="promise_arrives" />
    <bpmn:messageFlow id="messageflow_27" name="Refusal with reason" sourceRef="refuse_with_the_reason" targetRef="read_the_outcome" />
    <bpmn:messageFlow id="messageflow_28" name="Rehearsal preview" sourceRef="preview_what_would_be_stored" targetRef="read_the_outcome" />
    <bpmn:messageFlow id="messageflow_29" name="Parked with its id" sourceRef="promise_parked" targetRef="read_the_outcome" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="collaboration">
      <bpmndi:BPMNShape id="shape_participant_owner" bpmnElement="participant_owner" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1150" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_participant_expected_register" bpmnElement="participant_expected_register" isHorizontal="true">
        <dc:Bounds x="160" y="390" width="1150" height="280" />
