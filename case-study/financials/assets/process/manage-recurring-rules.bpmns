process "Owner"
  start "A standing commitment needs attention"
  exclusive "What does the commitment need?"
    if "Define or adjust it as a rule" then
      send "State the rule's details and answer the questions"
      receive "See the rule saved or the reason it was not"
    if "A recurring bill landed" then
      send "Confirm the occurrence as booked"
      receive "See the commitment marked as landed"
    if "Only review it" then
      send "Ask for the rules and their next occurrences"
      receive "See the rules and their forecasts"
  exclusive "More standing commitments to tend?"
    if "Yes" then goto "What does the commitment need?"
    else "No"
  end "The rule set reflects the commitments"

process "Financials program"
  start "A commitment request arrives"
  script "Serve the request and run the house checks on what was stated"
  exclusive "Did the request pass the checks?"
    if "No" then
      task "Tell the reason and store nothing"
      end "Nothing stored"
    else "Yes"
  script "Do the accepted work — save the checked rule, commit a landed occurrence or project the forecast window"
  end "Request served"

message flows
  from "Owner"."State the rule's details and answer the questions" to "Financials program"."A commitment request arrives" label "Rule statement"
  from "Owner"."Confirm the occurrence as booked" to "Financials program"."A commitment request arrives" label "Confirmation request"
  from "Owner"."Ask for the rules and their next occurrences" to "Financials program"."A commitment request arrives" label "Listing request"
  from "Financials program"."Tell the reason and store nothing" to "Owner"."See the rule saved or the reason it was not" label "Refusal with the reason"
  from "Financials program"."Request served" to "Owner"."See the commitment marked as landed" label "Confirmed"
  from "Financials program"."Request served" to "Owner"."See the rules and their forecasts" label "Shown"
  from "Financials program"."Request served" to "Owner"."See the rule saved or the reason it was not" label "Rule settled"