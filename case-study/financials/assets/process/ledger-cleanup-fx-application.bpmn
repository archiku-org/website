<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="definitions" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:process id="process_household_bookkeeper">
    <bpmn:userTask id="hand_one_change_set_file_or_the_whole_pending_set_to_the_tool" name="Hand one change-set file or the whole pending set to the tool" />
    <bpmn:startEvent id="reviewed_cleanup_change_sets_are_ready_to_apply" name="Reviewed cleanup change-sets are ready to apply" />
    <bpmn:receiveTask id="read_the_application_outcome" name="Read the application outcome" />
    <bpmn:exclusiveGateway id="every_change_set_applied_cleanly" name="Every change-set applied cleanly?" />
    <bpmn:endEvent id="books_cleaned_up" name="Books cleaned up" />
    <bpmn:userTask id="repair_the_refused_fixes_in_the_change_set" name="Repair the refused fixes in the change-set" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="reviewed_cleanup_change_sets_are_ready_to_apply" targetRef="hand_one_change_set_file_or_the_whole_pending_set_to_the_tool" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="hand_one_change_set_file_or_the_whole_pending_set_to_the_tool" targetRef="read_the_application_outcome" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="read_the_application_outcome" targetRef="every_change_set_applied_cleanly" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="repair_the_refused_fixes_in_the_change_set" targetRef="hand_one_change_set_file_or_the_whole_pending_set_to_the_tool" />
    <bpmn:sequenceFlow id="flow_5" name="No - a fix was refused" sourceRef="every_change_set_applied_cleanly" targetRef="repair_the_refused_fixes_in_the_change_set" />
    <bpmn:sequenceFlow id="flow_6" name="Yes" sourceRef="every_change_set_applied_cleanly" targetRef="books_cleaned_up" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="every_change_set_applied_cleanly" targetRef="books_cleaned_up" />
  </bpmn:process>
  <bpmn:process id="process_cleanup_fix_engine">
    <bpmn:serviceTask id="load_the_reviewed_fixes_from_the_change_set" name="Load the reviewed fixes from the change-set" />
    <bpmn:startEvent id="apply_request_arrives" name="Apply request arrives" />
    <bpmn:task id="resolve_one_fix_against_the_ledger_and_check_its_guards" name="Resolve one fix against the ledger and check its guards" />
    <bpmn:exclusiveGateway id="fix_is_clear" name="Fix is clear?" />
    <bpmn:exclusiveGateway id="more_fixes_in_the_change_set" name="More fixes in the change-set?" />
    <bpmn:endEvent id="run_aborted_at_the_refused_fix" name="Run aborted at the refused fix" />
    <bpmn:serviceTask id="land_the_correction_as_one_recorded_ledger_change" name="Land the correction as one recorded ledger change" />
    <bpmn:exclusiveGateway id="pending_sweep_mode" name="Pending sweep mode?" />
    <bpmn:endEvent id="change_set_fully_handled" name="Change-set fully handled" />
    <bpmn:serviceTask id="mark_the_applied_change_set_with_the_applied_marker" name="Mark the applied change-set with the applied marker" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="apply_request_arrives" targetRef="load_the_reviewed_fixes_from_the_change_set" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="load_the_reviewed_fixes_from_the_change_set" targetRef="resolve_one_fix_against_the_ledger_and_check_its_guards" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="resolve_one_fix_against_the_ledger_and_check_its_guards" targetRef="fix_is_clear" />
    <bpmn:sequenceFlow id="flow_11" name="No" sourceRef="fix_is_clear" targetRef="run_aborted_at_the_refused_fix" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="land_the_correction_as_one_recorded_ledger_change" targetRef="more_fixes_in_the_change_set" />
    <bpmn:sequenceFlow id="flow_13" name="Yes" sourceRef="fix_is_clear" targetRef="land_the_correction_as_one_recorded_ledger_change" />
    <bpmn:sequenceFlow id="flow_14" sourceRef="fix_is_clear" targetRef="more_fixes_in_the_change_set" />
    <bpmn:sequenceFlow id="flow_15" name="Yes" sourceRef="more_fixes_in_the_change_set" targetRef="resolve_one_fix_against_the_ledger_and_check_its_guards" />
    <bpmn:sequenceFlow id="flow_16" name="No" sourceRef="more_fixes_in_the_change_set" targetRef="pending_sweep_mode" />
    <bpmn:sequenceFlow id="flow_17" sourceRef="more_fixes_in_the_change_set" targetRef="pending_sweep_mode" />
    <bpmn:sequenceFlow id="flow_18" sourceRef="mark_the_applied_change_set_with_the_applied_marker" targetRef="change_set_fully_handled" />
    <bpmn:sequenceFlow id="flow_19" name="Yes" sourceRef="pending_sweep_mode" targetRef="mark_the_applied_change_set_with_the_applied_marker" />
    <bpmn:sequenceFlow id="flow_20" name="No" sourceRef="pending_sweep_mode" targetRef="change_set_fully_handled" />
    <bpmn:sequenceFlow id="flow_21" sourceRef="pending_sweep_mode" targetRef="change_set_fully_handled" />
  </bpmn:process>
  <bpmn:process id="process_journaled_ledger_engine">
    <bpmn:serviceTask id="mint_the_record_s_content_identity_and_append_it_to_the_change_journal" name="Mint the record's content identity and append it to the change journal" />
    <bpmn:startEvent id="one_fix_s_recorded_change_is_ready" name="One fix's recorded change is ready" />
    <bpmn:serviceTask id="rebook_the_ledger_and_persist_the_converged_snapshot" name="Rebook the ledger and persist the converged snapshot" />
    <bpmn:endEvent id="the_change_is_recorded" name="The change is recorded" />
    <bpmn:sequenceFlow id="flow_22" sourceRef="one_fix_s_recorded_change_is_ready" targetRef="mint_the_record_s_content_identity_and_append_it_to_the_change_journal" />
    <bpmn:sequenceFlow id="flow_23" sourceRef="mint_the_record_s_content_identity_and_append_it_to_the_change_journal" targetRef="rebook_the_ledger_and_persist_the_converged_snapshot" />
    <bpmn:sequenceFlow id="flow_24" sourceRef="rebook_the_ledger_and_persist_the_converged_snapshot" targetRef="the_change_is_recorded" />
  </bpmn:process>
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="participant_household_bookkeeper" name="household bookkeeper" processRef="process_household_bookkeeper" />
    <bpmn:participant id="participant_cleanup_fix_engine" name="cleanup fix engine" processRef="process_cleanup_fix_engine" />
    <bpmn:participant id="participant_journaled_ledger_engine" name="journaled ledger engine" processRef="process_journaled_ledger_engine" />
    <bpmn:messageFlow id="messageflow_25" name="Apply request" sourceRef="hand_one_change_set_file_or_the_whole_pending_set_to_the_tool" targetRef="apply_request_arrives" />
    <bpmn:messageFlow id="messageflow_26" name="Refusal" sourceRef="run_aborted_at_the_refused_fix" targetRef="read_the_application_outcome" />
    <bpmn:messageFlow id="messageflow_27" name="Application result" sourceRef="change_set_fully_handled" targetRef="read_the_application_outcome" />
    <bpmn:messageFlow id="messageflow_28" name="Recorded change" sourceRef="land_the_correction_as_one_recorded_ledger_change" targetRef="one_fix_s_recorded_change_is_ready" />
    <bpmn:messageFlow id="messageflow_29" name="Recorded" sourceRef="the_change_is_recorded" targetRef="resolve_one_fix_against_the_ledger_and_check_its_guards" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="collaboration">
      <bpmndi:BPMNShape id="shape_participant_household_bookkeeper" bpmnElement="participant_household_bookkeeper" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1470" height="280" />
