<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="definitions" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:process id="process_owner">
    <bpmn:userTask id="bring_the_occurrence_s_address_to_a_booking_door" name="Bring the occurrence's address to a booking door" />
    <bpmn:startEvent id="the_forecast_shows_the_occurrence_or_its_day_arrives" name="The forecast shows the occurrence or its day arrives" />
    <bpmn:exclusiveGateway id="what_does_the_owner_want_with_this_occurrence" name="What does the owner want with this occurrence?" />
    <bpmn:userTask id="see_the_posted_result" name="See the posted result" />
    <bpmn:exclusiveGateway id="has_the_occurrence_s_day_arrived" name="Has the occurrence's day arrived?" />
    <bpmn:sendTask id="hand_the_instance_to_the_confirmation_desk" name="Hand the instance to the confirmation desk" />
    <bpmn:exclusiveGateway id="does_the_typed_day_stay_on_or_before_today" name="Does the typed day stay on or before today?" />
    <bpmn:userTask id="walk_the_prefilled_questions_the_day_asked_first" name="Walk the prefilled questions, the day asked first" />
    <bpmn:sendTask id="hand_the_walked_instance_to_the_desk" name="Hand the walked instance to the desk" />
    <bpmn:sendTask id="hand_the_reshaped_occurrence_to_the_editor" name="Hand the reshaped occurrence to the editor" />
    <bpmn:userTask id="reshape_the_occurrence_s_fields_the_day_asked_first" name="Reshape the occurrence's fields, the day asked first" />
    <bpmn:exclusiveGateway id="was_the_yes_stated" name="Was the yes stated?" />
    <bpmn:userTask id="type_the_yes_that_approves_the_suppression" name="Type the yes that approves the suppression" />
    <bpmn:sendTask id="hand_the_suppressed_occurrence_to_the_editor" name="Hand the suppressed occurrence to the editor" />
    <bpmn:endEvent id="the_occurrence_is_settled" name="The occurrence is settled" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="the_forecast_shows_the_occurrence_or_its_day_arrives" targetRef="bring_the_occurrence_s_address_to_a_booking_door" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="bring_the_occurrence_s_address_to_a_booking_door" targetRef="what_does_the_owner_want_with_this_occurrence" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="hand_the_instance_to_the_confirmation_desk" targetRef="see_the_posted_result" />
    <bpmn:sequenceFlow id="flow_4" name="Arrived" sourceRef="has_the_occurrence_s_day_arrived" targetRef="hand_the_instance_to_the_confirmation_desk" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="walk_the_prefilled_questions_the_day_asked_first" targetRef="does_the_typed_day_stay_on_or_before_today" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="hand_the_walked_instance_to_the_desk" targetRef="see_the_posted_result" />
    <bpmn:sequenceFlow id="flow_7" name="Today or earlier" sourceRef="does_the_typed_day_stay_on_or_before_today" targetRef="hand_the_walked_instance_to_the_desk" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="does_the_typed_day_stay_on_or_before_today" targetRef="see_the_posted_result" />
    <bpmn:sequenceFlow id="flow_9" name="Still ahead" sourceRef="has_the_occurrence_s_day_arrived" targetRef="walk_the_prefilled_questions_the_day_asked_first" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="has_the_occurrence_s_day_arrived" targetRef="see_the_posted_result" />
    <bpmn:sequenceFlow id="flow_11" name="Book the money" sourceRef="what_does_the_owner_want_with_this_occurrence" targetRef="has_the_occurrence_s_day_arrived" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="reshape_the_occurrence_s_fields_the_day_asked_first" targetRef="hand_the_reshaped_occurrence_to_the_editor" />
    <bpmn:sequenceFlow id="flow_13" sourceRef="hand_the_reshaped_occurrence_to_the_editor" targetRef="see_the_posted_result" />
    <bpmn:sequenceFlow id="flow_14" name="Reshape this month into a promise" sourceRef="what_does_the_owner_want_with_this_occurrence" targetRef="reshape_the_occurrence_s_fields_the_day_asked_first" />
    <bpmn:sequenceFlow id="flow_15" sourceRef="type_the_yes_that_approves_the_suppression" targetRef="was_the_yes_stated" />
    <bpmn:sequenceFlow id="flow_16" sourceRef="hand_the_suppressed_occurrence_to_the_editor" targetRef="see_the_posted_result" />
    <bpmn:sequenceFlow id="flow_17" name="Yes" sourceRef="was_the_yes_stated" targetRef="hand_the_suppressed_occurrence_to_the_editor" />
    <bpmn:sequenceFlow id="flow_18" sourceRef="was_the_yes_stated" targetRef="see_the_posted_result" />
    <bpmn:sequenceFlow id="flow_19" name="Suppress this month" sourceRef="what_does_the_owner_want_with_this_occurrence" targetRef="type_the_yes_that_approves_the_suppression" />
    <bpmn:sequenceFlow id="flow_20" sourceRef="what_does_the_owner_want_with_this_occurrence" targetRef="see_the_posted_result" />
    <bpmn:sequenceFlow id="flow_21" sourceRef="see_the_posted_result" targetRef="the_occurrence_is_settled" />
  </bpmn:process>
  <bpmn:process id="process_open_entry_confirmation">
    <bpmn:serviceTask id="post_the_movement_and_retire_the_promise" name="Post the movement and retire the promise" />
    <bpmn:startEvent id="the_desk_opens_the_instance" name="The desk opens the instance" />
    <bpmn:exclusiveGateway id="does_the_posting_match_the_rule_s_mark" name="Does the posting match the rule's mark?" />
    <bpmn:endEvent id="the_desk_closes_the_occurrence" name="The desk closes the occurrence" />
    <bpmn:serviceTask id="record_this_occurrence_as_the_rule_s_exception" name="Record this occurrence as the rule's exception" />
    <bpmn:sequenceFlow id="flow_22" sourceRef="the_desk_opens_the_instance" targetRef="post_the_movement_and_retire_the_promise" />
    <bpmn:sequenceFlow id="flow_23" sourceRef="post_the_movement_and_retire_the_promise" targetRef="does_the_posting_match_the_rule_s_mark" />
    <bpmn:sequenceFlow id="flow_24" name="On the mark" sourceRef="does_the_posting_match_the_rule_s_mark" targetRef="the_desk_closes_the_occurrence" />
    <bpmn:sequenceFlow id="flow_25" sourceRef="record_this_occurrence_as_the_rule_s_exception" targetRef="the_desk_closes_the_occurrence" />
    <bpmn:sequenceFlow id="flow_26" name="Drifted" sourceRef="does_the_posting_match_the_rule_s_mark" targetRef="record_this_occurrence_as_the_rule_s_exception" />
    <bpmn:sequenceFlow id="flow_27" sourceRef="does_the_posting_match_the_rule_s_mark" targetRef="the_desk_closes_the_occurrence" />
  </bpmn:process>
  <bpmn:process id="process_recurrence_planner">
    <bpmn:exclusiveGateway id="what_was_asked_of_the_editor" name="What was asked of the editor?" />
    <bpmn:startEvent id="the_editor_opens_the_occurrence" name="The editor opens the occurrence" />
    <bpmn:endEvent id="the_editor_closes_the_occurrence" name="The editor closes the occurrence" />
    <bpmn:serviceTask id="add_the_occurrence_s_date_to_the_rule_s_exceptions" name="Add the occurrence's date to the rule's exceptions" />
    <bpmn:receiveTask id="take_the_stored_promise_back" name="Take the stored promise back" />
    <bpmn:sendTask id="offer_the_reshaped_promise_to_the_register" name="Offer the reshaped promise to the register" />
    <bpmn:serviceTask id="except_the_occurrence_replaced_by_the_promise" name="Except the occurrence replaced by the promise" />
    <bpmn:sequenceFlow id="flow_28" sourceRef="the_editor_opens_the_occurrence" targetRef="what_was_asked_of_the_editor" />
    <bpmn:sequenceFlow id="flow_29" sourceRef="add_the_occurrence_s_date_to_the_rule_s_exceptions" targetRef="the_editor_closes_the_occurrence" />
    <bpmn:sequenceFlow id="flow_30" name="Suppress this occurrence" sourceRef="what_was_asked_of_the_editor" targetRef="add_the_occurrence_s_date_to_the_rule_s_exceptions" />
    <bpmn:sequenceFlow id="flow_31" sourceRef="offer_the_reshaped_promise_to_the_register" targetRef="take_the_stored_promise_back" />
    <bpmn:sequenceFlow id="flow_32" sourceRef="take_the_stored_promise_back" targetRef="except_the_occurrence_replaced_by_the_promise" />
    <bpmn:sequenceFlow id="flow_33" sourceRef="except_the_occurrence_replaced_by_the_promise" targetRef="the_editor_closes_the_occurrence" />
    <bpmn:sequenceFlow id="flow_34" name="Reshape into a promise" sourceRef="what_was_asked_of_the_editor" targetRef="offer_the_reshaped_promise_to_the_register" />
    <bpmn:sequenceFlow id="flow_35" sourceRef="what_was_asked_of_the_editor" targetRef="the_editor_closes_the_occurrence" />
  </bpmn:process>
  <bpmn:process id="process_expected_register">
    <bpmn:exclusiveGateway id="is_the_promise_s_day_still_strictly_ahead_of_today" name="Is the promise's day still strictly ahead of today?" />
    <bpmn:startEvent id="the_register_receives_a_reshaped_promise" name="The register receives a reshaped promise" />
    <bpmn:endEvent id="the_register_hands_the_promise_to_the_books" name="The register hands the promise to the books" />
    <bpmn:endEvent id="the_register_rejects_the_promise" name="The register rejects the promise" />
    <bpmn:serviceTask id="store_the_promise_under_its_own_id" name="Store the promise under its own id" />
    <bpmn:sequenceFlow id="flow_36" sourceRef="the_register_receives_a_reshaped_promise" targetRef="is_the_promise_s_day_still_strictly_ahead_of_today" />
    <bpmn:sequenceFlow id="flow_37" name="Today or past" sourceRef="is_the_promise_s_day_still_strictly_ahead_of_today" targetRef="the_register_rejects_the_promise" />
    <bpmn:sequenceFlow id="flow_38" sourceRef="store_the_promise_under_its_own_id" targetRef="the_register_hands_the_promise_to_the_books" />
    <bpmn:sequenceFlow id="flow_39" name="Still ahead" sourceRef="is_the_promise_s_day_still_strictly_ahead_of_today" targetRef="store_the_promise_under_its_own_id" />
    <bpmn:sequenceFlow id="flow_40" sourceRef="is_the_promise_s_day_still_strictly_ahead_of_today" targetRef="the_register_hands_the_promise_to_the_books" />
  </bpmn:process>
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="participant_owner" name="Owner" processRef="process_owner" />
    <bpmn:participant id="participant_open_entry_confirmation" name="Open-entry confirmation" processRef="process_open_entry_confirmation" />
    <bpmn:participant id="participant_recurrence_planner" name="Recurrence planner" processRef="process_recurrence_planner" />
    <bpmn:participant id="participant_expected_register" name="Expected register" processRef="process_expected_register" />
    <bpmn:messageFlow id="messageflow_41" name="Landed instance request" sourceRef="hand_the_instance_to_the_confirmation_desk" targetRef="the_desk_opens_the_instance" />
    <bpmn:messageFlow id="messageflow_42" name="Walked instance request" sourceRef="hand_the_walked_instance_to_the_desk" targetRef="the_desk_opens_the_instance" />
    <bpmn:messageFlow id="messageflow_43" name="Exception request" sourceRef="hand_the_reshaped_occurrence_to_the_editor" targetRef="the_editor_opens_the_occurrence" />
    <bpmn:messageFlow id="messageflow_44" name="Suppression request" sourceRef="hand_the_suppressed_occurrence_to_the_editor" targetRef="the_editor_opens_the_occurrence" />
    <bpmn:messageFlow id="messageflow_45" name="Promise admission" sourceRef="offer_the_reshaped_promise_to_the_register" targetRef="the_register_receives_a_reshaped_promise" />
    <bpmn:messageFlow id="messageflow_46" name="Promise stored" sourceRef="store_the_promise_under_its_own_id" targetRef="take_the_stored_promise_back" />
    <bpmn:messageFlow id="messageflow_47" name="Promise refusal" sourceRef="the_register_rejects_the_promise" targetRef="see_the_posted_result" />
    <bpmn:messageFlow id="messageflow_48" name="Balance result" sourceRef="the_desk_closes_the_occurrence" targetRef="see_the_posted_result" />
    <bpmn:messageFlow id="messageflow_49" name="Editor result" sourceRef="the_editor_closes_the_occurrence" targetRef="see_the_posted_result" />
  </bpmn:collaboration>
