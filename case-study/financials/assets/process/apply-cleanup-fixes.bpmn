<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="definitions" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:process id="process_bookkeeper">
    <bpmn:userTask id="choose_the_batch_to_apply" name="Choose the batch to apply" />
    <bpmn:startEvent id="a_reviewed_batch_of_corrections_is_ready" name="A reviewed batch of corrections is ready" />
    <bpmn:sendTask id="hand_the_batch_to_the_program" name="Hand the batch to the program" />
    <bpmn:receiveTask id="hear_the_application_outcome" name="Hear the application outcome" />
    <bpmn:exclusiveGateway id="did_every_entry_land" name="Did every entry land?" />
    <bpmn:endEvent id="the_books_carry_the_reviewed_corrections" name="The books carry the reviewed corrections" />
    <bpmn:userTask id="correct_the_batch_file_by_hand" name="Correct the batch file by hand" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="a_reviewed_batch_of_corrections_is_ready" targetRef="choose_the_batch_to_apply" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="choose_the_batch_to_apply" targetRef="hand_the_batch_to_the_program" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="hand_the_batch_to_the_program" targetRef="hear_the_application_outcome" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="hear_the_application_outcome" targetRef="did_every_entry_land" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="correct_the_batch_file_by_hand" targetRef="choose_the_batch_to_apply" />
    <bpmn:sequenceFlow id="flow_6" name="An entry was refused" sourceRef="did_every_entry_land" targetRef="correct_the_batch_file_by_hand" />
    <bpmn:sequenceFlow id="flow_7" name="Applied" sourceRef="did_every_entry_land" targetRef="the_books_carry_the_reviewed_corrections" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="did_every_entry_land" targetRef="the_books_carry_the_reviewed_corrections" />
  </bpmn:process>
  <bpmn:process id="process_financials_program">
    <bpmn:exclusiveGateway id="one_named_file_or_all_pending" name="One named file or all pending?" />
    <bpmn:startEvent id="batch_application_requested" name="Batch application requested" />
    <bpmn:serviceTask id="split_field_corrections_from_row_operations" name="Split field corrections from row operations" />
    <bpmn:serviceTask id="gather_the_pending_fix_files_oldest_first" name="Gather the pending fix files oldest first" />
    <bpmn:serviceTask id="load_the_named_batch_file" name="Load the named batch file" />
    <bpmn:exclusiveGateway id="what_does_the_entry_act_on" name="What does the entry act on?" />
    <bpmn:exclusiveGateway id="more_entries_in_the_batch" name="More entries in the batch?" />
    <bpmn:exclusiveGateway id="the_correction_is_safe_to_receive" name="The correction is safe to receive?" />
    <bpmn:serviceTask id="check_the_row_and_its_stated_old_value" name="Check the row and its stated old value" />
    <bpmn:serviceTask id="journal_one_update_event_with_the_row_s_final_state" name="Journal one update event with the row's final state" />
    <bpmn:endEvent id="the_batch_stops_at_the_refused_entry" name="The batch stops at the refused entry" />
    <bpmn:exclusiveGateway id="which_row_act" name="Which row act?" />
    <bpmn:serviceTask id="journal_a_removal_event_with_the_row_s_full_picture" name="Journal a removal event with the row's full picture" />
    <bpmn:serviceTask id="drop_the_plan_from_the_register" name="Drop the plan from the register" />
    <bpmn:serviceTask id="write_the_new_plan_into_the_register" name="Write the new plan into the register" />
    <bpmn:serviceTask id="report_the_applied_count" name="Report the applied count" />
    <bpmn:exclusiveGateway id="was_this_an_all_pending_run" name="Was this an all-pending run?" />
    <bpmn:endEvent id="batch_application_complete" name="Batch application complete" />
    <bpmn:serviceTask id="mark_the_consumed_file_applied" name="Mark the consumed file applied" />
    <bpmn:serviceTask id="leave_the_file_as_is" name="Leave the file as is" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="batch_application_requested" targetRef="one_named_file_or_all_pending" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="gather_the_pending_fix_files_oldest_first" targetRef="split_field_corrections_from_row_operations" />
    <bpmn:sequenceFlow id="flow_11" name="All pending" sourceRef="one_named_file_or_all_pending" targetRef="gather_the_pending_fix_files_oldest_first" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="load_the_named_batch_file" targetRef="split_field_corrections_from_row_operations" />
    <bpmn:sequenceFlow id="flow_13" name="One named file" sourceRef="one_named_file_or_all_pending" targetRef="load_the_named_batch_file" />
    <bpmn:sequenceFlow id="flow_14" sourceRef="one_named_file_or_all_pending" targetRef="split_field_corrections_from_row_operations" />
    <bpmn:sequenceFlow id="flow_15" sourceRef="split_field_corrections_from_row_operations" targetRef="what_does_the_entry_act_on" />
    <bpmn:sequenceFlow id="flow_16" sourceRef="check_the_row_and_its_stated_old_value" targetRef="the_correction_is_safe_to_receive" />
    <bpmn:sequenceFlow id="flow_17" sourceRef="journal_one_update_event_with_the_row_s_final_state" targetRef="more_entries_in_the_batch" />
    <bpmn:sequenceFlow id="flow_18" name="Yes" sourceRef="the_correction_is_safe_to_receive" targetRef="journal_one_update_event_with_the_row_s_final_state" />
    <bpmn:sequenceFlow id="flow_19" name="No - refuse loudly" sourceRef="the_correction_is_safe_to_receive" targetRef="the_batch_stops_at_the_refused_entry" />
    <bpmn:sequenceFlow id="flow_20" sourceRef="the_correction_is_safe_to_receive" targetRef="more_entries_in_the_batch" />
    <bpmn:sequenceFlow id="flow_21" name="A field of a recorded row" sourceRef="what_does_the_entry_act_on" targetRef="check_the_row_and_its_stated_old_value" />
    <bpmn:sequenceFlow id="flow_22" sourceRef="journal_a_removal_event_with_the_row_s_full_picture" targetRef="more_entries_in_the_batch" />
    <bpmn:sequenceFlow id="flow_23" name="Remove a recorded row" sourceRef="which_row_act" targetRef="journal_a_removal_event_with_the_row_s_full_picture" />
    <bpmn:sequenceFlow id="flow_24" sourceRef="drop_the_plan_from_the_register" targetRef="more_entries_in_the_batch" />
    <bpmn:sequenceFlow id="flow_25" name="Withdraw a planned entry" sourceRef="which_row_act" targetRef="drop_the_plan_from_the_register" />
    <bpmn:sequenceFlow id="flow_26" sourceRef="write_the_new_plan_into_the_register" targetRef="more_entries_in_the_batch" />
    <bpmn:sequenceFlow id="flow_27" name="Add a planned entry" sourceRef="which_row_act" targetRef="write_the_new_plan_into_the_register" />
    <bpmn:sequenceFlow id="flow_28" sourceRef="which_row_act" targetRef="more_entries_in_the_batch" />
    <bpmn:sequenceFlow id="flow_29" name="A whole row" sourceRef="what_does_the_entry_act_on" targetRef="which_row_act" />
    <bpmn:sequenceFlow id="flow_30" sourceRef="what_does_the_entry_act_on" targetRef="more_entries_in_the_batch" />
    <bpmn:sequenceFlow id="flow_31" name="Yes" sourceRef="more_entries_in_the_batch" targetRef="what_does_the_entry_act_on" />
    <bpmn:sequenceFlow id="flow_32" name="No" sourceRef="more_entries_in_the_batch" targetRef="report_the_applied_count" />
    <bpmn:sequenceFlow id="flow_33" sourceRef="more_entries_in_the_batch" targetRef="report_the_applied_count" />
    <bpmn:sequenceFlow id="flow_34" sourceRef="report_the_applied_count" targetRef="was_this_an_all_pending_run" />
    <bpmn:sequenceFlow id="flow_35" sourceRef="mark_the_consumed_file_applied" targetRef="batch_application_complete" />
    <bpmn:sequenceFlow id="flow_36" name="Yes and every entry landed" sourceRef="was_this_an_all_pending_run" targetRef="mark_the_consumed_file_applied" />
    <bpmn:sequenceFlow id="flow_37" sourceRef="leave_the_file_as_is" targetRef="batch_application_complete" />
    <bpmn:sequenceFlow id="flow_38" name="No" sourceRef="was_this_an_all_pending_run" targetRef="leave_the_file_as_is" />
    <bpmn:sequenceFlow id="flow_39" sourceRef="was_this_an_all_pending_run" targetRef="batch_application_complete" />
  </bpmn:process>
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="participant_bookkeeper" name="Bookkeeper" processRef="process_bookkeeper" />
    <bpmn:participant id="participant_financials_program" name="financials program" processRef="process_financials_program" />
    <bpmn:messageFlow id="messageflow_40" name="Apply request" sourceRef="hand_the_batch_to_the_program" targetRef="batch_application_requested" />
    <bpmn:messageFlow id="messageflow_41" name="Loud refusal" sourceRef="the_batch_stops_at_the_refused_entry" targetRef="hear_the_application_outcome" />
    <bpmn:messageFlow id="messageflow_42" name="Application outcome" sourceRef="batch_application_complete" targetRef="hear_the_application_outcome" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="collaboration">
