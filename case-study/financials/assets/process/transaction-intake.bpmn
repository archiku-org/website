<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="definitions" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:process id="process_household_bookkeeper">
    <bpmn:sendTask id="record_the_movement_financials_add" name="Record the movement (financials add)" />
    <bpmn:startEvent id="a_spend_or_income_happens_or_is_remembered" name="A spend or income happens or is remembered" />
    <bpmn:receiveTask id="take_in_the_saved_confirmation" name="Take in the saved confirmation" />
    <bpmn:endEvent id="the_recording_is_accounted_for" name="The recording is accounted for" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="a_spend_or_income_happens_or_is_remembered" targetRef="record_the_movement_financials_add" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="record_the_movement_financials_add" targetRef="take_in_the_saved_confirmation" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="take_in_the_saved_confirmation" targetRef="the_recording_is_accounted_for" />
  </bpmn:process>
  <bpmn:process id="process_transaction_entry_interface">
    <bpmn:task id="take_in_the_entry_s_details_asking_for_anything_missing" name="Take in the entry's details, asking for anything missing" />
    <bpmn:startEvent id="start_the_intake" name="Start the intake" />
    <bpmn:exclusiveGateway id="did_the_quick_add_line_fail_or_the_bookkeeper_abandon" name="Did the quick-add line fail or the bookkeeper abandon?" />
    <bpmn:exclusiveGateway id="entered_through_the_prompts" name="Entered through the prompts?" />
    <bpmn:endEvent id="nothing_stored_the_stop_is_shown" name="Nothing stored — the stop is shown" />
    <bpmn:task id="check_the_details_date_description_approved_category_and_non_zero_amount" name="Check the details date, description, approved category and non-zero amount" />
    <bpmn:task id="confirm_the_projected_checking_balance" name="Confirm the projected checking balance" />
    <bpmn:exclusiveGateway id="are_all_details_accepted" name="Are all details accepted?" />
    <bpmn:exclusiveGateway id="is_the_entry_dated_after_today" name="Is the entry dated after today?" />
    <bpmn:endEvent id="nothing_stored_the_refusal_is_shown" name="Nothing stored — the refusal is shown" />
    <bpmn:task id="echo_the_saved_entry_and_its_resulting_balances" name="Echo the saved entry and its resulting balances" />
    <bpmn:sendTask id="hand_the_entry_to_the_expected_register" name="Hand the entry to the expected register" />
    <bpmn:sendTask id="post_the_movement_to_the_journaled_ledger" name="Post the movement to the journaled ledger" />
    <bpmn:endEvent id="the_recording_is_saved" name="The recording is saved" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="start_the_intake" targetRef="take_in_the_entry_s_details_asking_for_anything_missing" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="take_in_the_entry_s_details_asking_for_anything_missing" targetRef="did_the_quick_add_line_fail_or_the_bookkeeper_abandon" />
    <bpmn:sequenceFlow id="flow_6" name="Stopped" sourceRef="did_the_quick_add_line_fail_or_the_bookkeeper_abandon" targetRef="nothing_stored_the_stop_is_shown" />
    <bpmn:sequenceFlow id="flow_7" name="Proceed" sourceRef="did_the_quick_add_line_fail_or_the_bookkeeper_abandon" targetRef="entered_through_the_prompts" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="did_the_quick_add_line_fail_or_the_bookkeeper_abandon" targetRef="entered_through_the_prompts" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="confirm_the_projected_checking_balance" targetRef="check_the_details_date_description_approved_category_and_non_zero_amount" />
    <bpmn:sequenceFlow id="flow_10" name="Yes" sourceRef="entered_through_the_prompts" targetRef="confirm_the_projected_checking_balance" />
    <bpmn:sequenceFlow id="flow_11" name="No" sourceRef="entered_through_the_prompts" targetRef="check_the_details_date_description_approved_category_and_non_zero_amount" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="entered_through_the_prompts" targetRef="check_the_details_date_description_approved_category_and_non_zero_amount" />
    <bpmn:sequenceFlow id="flow_13" sourceRef="check_the_details_date_description_approved_category_and_non_zero_amount" targetRef="are_all_details_accepted" />
    <bpmn:sequenceFlow id="flow_14" name="No" sourceRef="are_all_details_accepted" targetRef="nothing_stored_the_refusal_is_shown" />
    <bpmn:sequenceFlow id="flow_15" name="Accepted" sourceRef="are_all_details_accepted" targetRef="is_the_entry_dated_after_today" />
    <bpmn:sequenceFlow id="flow_16" sourceRef="are_all_details_accepted" targetRef="is_the_entry_dated_after_today" />
    <bpmn:sequenceFlow id="flow_17" sourceRef="hand_the_entry_to_the_expected_register" targetRef="echo_the_saved_entry_and_its_resulting_balances" />
    <bpmn:sequenceFlow id="flow_18" name="Future entry" sourceRef="is_the_entry_dated_after_today" targetRef="hand_the_entry_to_the_expected_register" />
    <bpmn:sequenceFlow id="flow_19" sourceRef="post_the_movement_to_the_journaled_ledger" targetRef="echo_the_saved_entry_and_its_resulting_balances" />
    <bpmn:sequenceFlow id="flow_20" name="Actual entry" sourceRef="is_the_entry_dated_after_today" targetRef="post_the_movement_to_the_journaled_ledger" />
    <bpmn:sequenceFlow id="flow_21" sourceRef="is_the_entry_dated_after_today" targetRef="echo_the_saved_entry_and_its_resulting_balances" />
    <bpmn:sequenceFlow id="flow_22" sourceRef="echo_the_saved_entry_and_its_resulting_balances" targetRef="the_recording_is_saved" />
  </bpmn:process>
  <bpmn:process id="process_expected_register_store">
    <bpmn:task id="check_the_plan_is_strictly_future_dated_in_an_approved_category" name="Check the plan is strictly future-dated in an approved category" />
    <bpmn:startEvent id="park_the_plan" name="Park the plan" />
    <bpmn:task id="save_the_parked_plan_as_given_amount_0_parks_a_placeholder" name="Save the parked plan as given — amount 0 parks a placeholder" />
    <bpmn:endEvent id="the_plan_is_parked" name="The plan is parked" />
    <bpmn:sequenceFlow id="flow_23" sourceRef="park_the_plan" targetRef="check_the_plan_is_strictly_future_dated_in_an_approved_category" />
    <bpmn:sequenceFlow id="flow_24" sourceRef="check_the_plan_is_strictly_future_dated_in_an_approved_category" targetRef="save_the_parked_plan_as_given_amount_0_parks_a_placeholder" />
    <bpmn:sequenceFlow id="flow_25" sourceRef="save_the_parked_plan_as_given_amount_0_parks_a_placeholder" targetRef="the_plan_is_parked" />
  </bpmn:process>
  <bpmn:process id="process_journaled_ledger_engine">
    <bpmn:task id="give_the_recording_its_identity_creation_time_and_content_hash" name="Give the recording its identity — creation time and content hash" />
    <bpmn:startEvent id="apply_the_movement" name="Apply the movement" />
    <bpmn:task id="append_the_recording_to_the_journal" name="Append the recording to the journal" />
    <bpmn:task id="rebuild_the_books_and_place_the_entry_at_its_date" name="Rebuild the books and place the entry at its date" />
    <bpmn:task id="carry_the_running_balances_forward_through_every_later_row" name="Carry the running balances forward through every later row" />
    <bpmn:task id="persist_the_settled_checkpoint" name="Persist the settled checkpoint" />
    <bpmn:endEvent id="the_movement_is_posted" name="The movement is posted" />
    <bpmn:sequenceFlow id="flow_26" sourceRef="apply_the_movement" targetRef="give_the_recording_its_identity_creation_time_and_content_hash" />
    <bpmn:sequenceFlow id="flow_27" sourceRef="give_the_recording_its_identity_creation_time_and_content_hash" targetRef="append_the_recording_to_the_journal" />
    <bpmn:sequenceFlow id="flow_28" sourceRef="append_the_recording_to_the_journal" targetRef="rebuild_the_books_and_place_the_entry_at_its_date" />
    <bpmn:sequenceFlow id="flow_29" sourceRef="rebuild_the_books_and_place_the_entry_at_its_date" targetRef="carry_the_running_balances_forward_through_every_later_row" />
    <bpmn:sequenceFlow id="flow_30" sourceRef="carry_the_running_balances_forward_through_every_later_row" targetRef="persist_the_settled_checkpoint" />
    <bpmn:sequenceFlow id="flow_31" sourceRef="persist_the_settled_checkpoint" targetRef="the_movement_is_posted" />
  </bpmn:process>
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="participant_household_bookkeeper" name="household bookkeeper" processRef="process_household_bookkeeper" />
    <bpmn:participant id="participant_transaction_entry_interface" name="transaction entry interface" processRef="process_transaction_entry_interface" />
    <bpmn:participant id="participant_expected_register_store" name="expected register store" processRef="process_expected_register_store" />
    <bpmn:participant id="participant_journaled_ledger_engine" name="journaled ledger engine" processRef="process_journaled_ledger_engine" />
    <bpmn:messageFlow id="messageflow_32" name="Recording request" sourceRef="record_the_movement_financials_add" targetRef="start_the_intake" />
    <bpmn:messageFlow id="messageflow_33" name="Future entry" sourceRef="hand_the_entry_to_the_expected_register" targetRef="park_the_plan" />
    <bpmn:messageFlow id="messageflow_34" name="Actual entry" sourceRef="post_the_movement_to_the_journaled_ledger" targetRef="apply_the_movement" />
    <bpmn:messageFlow id="messageflow_35" name="Parked confirmation" sourceRef="the_plan_is_parked" targetRef="echo_the_saved_entry_and_its_resulting_balances" />
    <bpmn:messageFlow id="messageflow_36" name="Applied confirmation" sourceRef="the_movement_is_posted" targetRef="echo_the_saved_entry_and_its_resulting_balances" />
    <bpmn:messageFlow id="messageflow_37" name="Saved confirmation" sourceRef="echo_the_saved_entry_and_its_resulting_balances" targetRef="take_in_the_saved_confirmation" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="collaboration">
