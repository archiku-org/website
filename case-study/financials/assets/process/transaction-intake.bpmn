<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="definitions" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:process id="process_owner">
    <bpmn:userTask id="state_the_movement" name="State the movement" />
    <bpmn:startEvent id="a_payment_or_receipt_needs_recording" name="A payment or receipt needs recording" />
    <bpmn:receiveTask id="hear_the_outcome" name="Hear the outcome" />
    <bpmn:endEvent id="the_movement_is_in_the_books" name="The movement is in the books" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="a_payment_or_receipt_needs_recording" targetRef="state_the_movement" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="state_the_movement" targetRef="hear_the_outcome" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="hear_the_outcome" targetRef="the_movement_is_in_the_books" />
  </bpmn:process>
  <bpmn:process id="process_financials">
    <bpmn:serviceTask id="understand_the_stated_entry" name="Understand the stated entry" />
    <bpmn:startEvent id="capture_request_arrives" name="Capture request arrives" />
    <bpmn:exclusiveGateway id="dated_after_today_and_fully_stated" name="Dated after today and fully stated?" />
    <bpmn:exclusiveGateway id="anything_still_missing" name="Anything still missing?" />
    <bpmn:serviceTask id="check_the_entry_against_the_house_rules" name="Check the entry against the house rules" />
    <bpmn:exclusiveGateway id="owner_confirmed_the_saldo_inside_three_tries" name="Owner confirmed the saldo inside three tries?" />
    <bpmn:userTask id="ask_for_the_missing_pieces_and_confirm_the_projected_saldo" name="Ask for the missing pieces and confirm the projected saldo" />
    <bpmn:exclusiveGateway id="the_completed_date_is_after_today" name="The completed date is after today?" />
    <bpmn:endEvent id="capture_abandoned" name="Capture abandoned" />
    <bpmn:task id="store_nothing_and_tell_the_owner_why" name="Store nothing and tell the owner why" />
    <bpmn:exclusiveGateway id="does_the_entry_pass" name="Does the entry pass?" />
    <bpmn:exclusiveGateway id="preview_only" name="Preview only?" />
    <bpmn:endEvent id="entry_refused" name="Entry refused" />
    <bpmn:task id="refuse_the_entry_with_the_stated_reason" name="Refuse the entry with the stated reason" />
    <bpmn:serviceTask id="record_the_movement_as_a_stored_event" name="Record the movement as a stored event" />
    <bpmn:endEvent id="preview_shown" name="Preview shown" />
    <bpmn:task id="show_what_would_be_stored_and_store_nothing" name="Show what would be stored and store nothing" />
    <bpmn:serviceTask id="bring_the_books_up_to_date_with_the_new_movement" name="Bring the books up to date with the new movement" />
    <bpmn:task id="report_the_saved_row_and_its_new_saldos" name="Report the saved row and its new saldos" />
    <bpmn:endEvent id="movement_stored" name="Movement stored" />
    <bpmn:task id="keep_the_entry_as_an_expectation_in_the_expected_register" name="Keep the entry as an expectation in the expected register" />
    <bpmn:task id="report_the_entry_kept_for_the_future" name="Report the entry kept for the future" />
    <bpmn:endEvent id="future_recorded" name="Future recorded" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="capture_request_arrives" targetRef="understand_the_stated_entry" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="understand_the_stated_entry" targetRef="dated_after_today_and_fully_stated" />
    <bpmn:sequenceFlow id="flow_6" name="No" sourceRef="dated_after_today_and_fully_stated" targetRef="anything_still_missing" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="dated_after_today_and_fully_stated" targetRef="anything_still_missing" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="ask_for_the_missing_pieces_and_confirm_the_projected_saldo" targetRef="owner_confirmed_the_saldo_inside_three_tries" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="store_nothing_and_tell_the_owner_why" targetRef="capture_abandoned" />
    <bpmn:sequenceFlow id="flow_10" name="No" sourceRef="owner_confirmed_the_saldo_inside_three_tries" targetRef="store_nothing_and_tell_the_owner_why" />
    <bpmn:sequenceFlow id="flow_11" name="Yes" sourceRef="owner_confirmed_the_saldo_inside_three_tries" targetRef="the_completed_date_is_after_today" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="owner_confirmed_the_saldo_inside_three_tries" targetRef="the_completed_date_is_after_today" />
    <bpmn:sequenceFlow id="flow_13" name="No" sourceRef="the_completed_date_is_after_today" targetRef="check_the_entry_against_the_house_rules" />
    <bpmn:sequenceFlow id="flow_14" sourceRef="the_completed_date_is_after_today" targetRef="check_the_entry_against_the_house_rules" />
    <bpmn:sequenceFlow id="flow_15" name="Yes" sourceRef="anything_still_missing" targetRef="ask_for_the_missing_pieces_and_confirm_the_projected_saldo" />
    <bpmn:sequenceFlow id="flow_16" name="No" sourceRef="anything_still_missing" targetRef="check_the_entry_against_the_house_rules" />
    <bpmn:sequenceFlow id="flow_17" sourceRef="anything_still_missing" targetRef="check_the_entry_against_the_house_rules" />
    <bpmn:sequenceFlow id="flow_18" sourceRef="check_the_entry_against_the_house_rules" targetRef="does_the_entry_pass" />
    <bpmn:sequenceFlow id="flow_19" sourceRef="refuse_the_entry_with_the_stated_reason" targetRef="entry_refused" />
    <bpmn:sequenceFlow id="flow_20" name="No" sourceRef="does_the_entry_pass" targetRef="refuse_the_entry_with_the_stated_reason" />
    <bpmn:sequenceFlow id="flow_21" name="Yes" sourceRef="does_the_entry_pass" targetRef="preview_only" />
    <bpmn:sequenceFlow id="flow_22" sourceRef="does_the_entry_pass" targetRef="preview_only" />
    <bpmn:sequenceFlow id="flow_23" sourceRef="show_what_would_be_stored_and_store_nothing" targetRef="preview_shown" />
    <bpmn:sequenceFlow id="flow_24" name="Yes" sourceRef="preview_only" targetRef="show_what_would_be_stored_and_store_nothing" />
    <bpmn:sequenceFlow id="flow_25" name="No" sourceRef="preview_only" targetRef="record_the_movement_as_a_stored_event" />
    <bpmn:sequenceFlow id="flow_26" sourceRef="preview_only" targetRef="record_the_movement_as_a_stored_event" />
    <bpmn:sequenceFlow id="flow_27" sourceRef="record_the_movement_as_a_stored_event" targetRef="bring_the_books_up_to_date_with_the_new_movement" />
    <bpmn:sequenceFlow id="flow_28" sourceRef="bring_the_books_up_to_date_with_the_new_movement" targetRef="report_the_saved_row_and_its_new_saldos" />
    <bpmn:sequenceFlow id="flow_29" sourceRef="report_the_saved_row_and_its_new_saldos" targetRef="movement_stored" />
    <bpmn:sequenceFlow id="flow_30" sourceRef="keep_the_entry_as_an_expectation_in_the_expected_register" targetRef="report_the_entry_kept_for_the_future" />
    <bpmn:sequenceFlow id="flow_31" sourceRef="report_the_entry_kept_for_the_future" targetRef="future_recorded" />
  </bpmn:process>
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="participant_owner" name="Owner" processRef="process_owner" />
    <bpmn:participant id="participant_financials" name="Financials" processRef="process_financials" />
    <bpmn:messageFlow id="messageflow_32" name="Capture request" sourceRef="state_the_movement" targetRef="capture_request_arrives" />
    <bpmn:messageFlow id="messageflow_33" name="Saved actual entry" sourceRef="report_the_saved_row_and_its_new_saldos" targetRef="hear_the_outcome" />
    <bpmn:messageFlow id="messageflow_34" name="Kept as expectation" sourceRef="report_the_entry_kept_for_the_future" targetRef="hear_the_outcome" />
    <bpmn:messageFlow id="messageflow_35" name="Refusal" sourceRef="refuse_the_entry_with_the_stated_reason" targetRef="hear_the_outcome" />
  </bpmn:collaboration>
