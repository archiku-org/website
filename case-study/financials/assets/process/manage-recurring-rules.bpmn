<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="definitions" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:process id="process_owner">
    <bpmn:exclusiveGateway id="what_does_the_commitment_need" name="What does the commitment need?" />
    <bpmn:startEvent id="a_standing_commitment_needs_attention" name="A standing commitment needs attention" />
    <bpmn:exclusiveGateway id="more_standing_commitments_to_tend" name="More standing commitments to tend?" />
    <bpmn:receiveTask id="see_the_rule_saved_or_the_reason_it_was_not" name="See the rule saved or the reason it was not" />
    <bpmn:sendTask id="state_the_rule_s_details_and_answer_the_questions" name="State the rule's details and answer the questions" />
    <bpmn:receiveTask id="see_the_commitment_marked_as_landed" name="See the commitment marked as landed" />
    <bpmn:sendTask id="confirm_the_occurrence_as_booked" name="Confirm the occurrence as booked" />
    <bpmn:receiveTask id="see_the_rules_and_their_forecasts" name="See the rules and their forecasts" />
    <bpmn:sendTask id="ask_for_the_rules_and_their_next_occurrences" name="Ask for the rules and their next occurrences" />
    <bpmn:endEvent id="the_rule_set_reflects_the_commitments" name="The rule set reflects the commitments" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="a_standing_commitment_needs_attention" targetRef="what_does_the_commitment_need" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="state_the_rule_s_details_and_answer_the_questions" targetRef="see_the_rule_saved_or_the_reason_it_was_not" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="see_the_rule_saved_or_the_reason_it_was_not" targetRef="more_standing_commitments_to_tend" />
    <bpmn:sequenceFlow id="flow_4" name="Define or adjust it as a rule" sourceRef="what_does_the_commitment_need" targetRef="state_the_rule_s_details_and_answer_the_questions" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="confirm_the_occurrence_as_booked" targetRef="see_the_commitment_marked_as_landed" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="see_the_commitment_marked_as_landed" targetRef="more_standing_commitments_to_tend" />
    <bpmn:sequenceFlow id="flow_7" name="A recurring bill landed" sourceRef="what_does_the_commitment_need" targetRef="confirm_the_occurrence_as_booked" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="ask_for_the_rules_and_their_next_occurrences" targetRef="see_the_rules_and_their_forecasts" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="see_the_rules_and_their_forecasts" targetRef="more_standing_commitments_to_tend" />
    <bpmn:sequenceFlow id="flow_10" name="Only review it" sourceRef="what_does_the_commitment_need" targetRef="ask_for_the_rules_and_their_next_occurrences" />
    <bpmn:sequenceFlow id="flow_11" sourceRef="what_does_the_commitment_need" targetRef="more_standing_commitments_to_tend" />
    <bpmn:sequenceFlow id="flow_12" name="Yes" sourceRef="more_standing_commitments_to_tend" targetRef="what_does_the_commitment_need" />
    <bpmn:sequenceFlow id="flow_13" name="No" sourceRef="more_standing_commitments_to_tend" targetRef="the_rule_set_reflects_the_commitments" />
    <bpmn:sequenceFlow id="flow_14" sourceRef="more_standing_commitments_to_tend" targetRef="the_rule_set_reflects_the_commitments" />
  </bpmn:process>
  <bpmn:process id="process_financials_program">
    <bpmn:scriptTask id="serve_the_request_and_run_the_house_checks_on_what_was_stated" name="Serve the request and run the house checks on what was stated" />
    <bpmn:startEvent id="a_commitment_request_arrives" name="A commitment request arrives" />
    <bpmn:exclusiveGateway id="did_the_request_pass_the_checks" name="Did the request pass the checks?" />
    <bpmn:scriptTask id="do_the_accepted_work_save_the_checked_rule_commit_a_landed_occurrence_or_project_the_forecast_window" name="Do the accepted work — save the checked rule, commit a landed occurrence or project the forecast window" />
    <bpmn:endEvent id="nothing_stored" name="Nothing stored" />
    <bpmn:task id="tell_the_reason_and_store_nothing" name="Tell the reason and store nothing" />
    <bpmn:endEvent id="request_served" name="Request served" />
    <bpmn:sequenceFlow id="flow_15" sourceRef="a_commitment_request_arrives" targetRef="serve_the_request_and_run_the_house_checks_on_what_was_stated" />
    <bpmn:sequenceFlow id="flow_16" sourceRef="serve_the_request_and_run_the_house_checks_on_what_was_stated" targetRef="did_the_request_pass_the_checks" />
    <bpmn:sequenceFlow id="flow_17" sourceRef="tell_the_reason_and_store_nothing" targetRef="nothing_stored" />
    <bpmn:sequenceFlow id="flow_18" name="No" sourceRef="did_the_request_pass_the_checks" targetRef="tell_the_reason_and_store_nothing" />
    <bpmn:sequenceFlow id="flow_19" name="Yes" sourceRef="did_the_request_pass_the_checks" targetRef="do_the_accepted_work_save_the_checked_rule_commit_a_landed_occurrence_or_project_the_forecast_window" />
    <bpmn:sequenceFlow id="flow_20" sourceRef="did_the_request_pass_the_checks" targetRef="do_the_accepted_work_save_the_checked_rule_commit_a_landed_occurrence_or_project_the_forecast_window" />
    <bpmn:sequenceFlow id="flow_21" sourceRef="do_the_accepted_work_save_the_checked_rule_commit_a_landed_occurrence_or_project_the_forecast_window" targetRef="request_served" />
  </bpmn:process>
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="participant_owner" name="Owner" processRef="process_owner" />
    <bpmn:participant id="participant_financials_program" name="Financials program" processRef="process_financials_program" />
    <bpmn:messageFlow id="messageflow_22" name="Rule statement" sourceRef="state_the_rule_s_details_and_answer_the_questions" targetRef="a_commitment_request_arrives" />
    <bpmn:messageFlow id="messageflow_23" name="Confirmation request" sourceRef="confirm_the_occurrence_as_booked" targetRef="a_commitment_request_arrives" />
    <bpmn:messageFlow id="messageflow_24" name="Listing request" sourceRef="ask_for_the_rules_and_their_next_occurrences" targetRef="a_commitment_request_arrives" />
    <bpmn:messageFlow id="messageflow_25" name="Refusal with the reason" sourceRef="tell_the_reason_and_store_nothing" targetRef="see_the_rule_saved_or_the_reason_it_was_not" />
    <bpmn:messageFlow id="messageflow_26" name="Confirmed" sourceRef="request_served" targetRef="see_the_commitment_marked_as_landed" />
    <bpmn:messageFlow id="messageflow_27" name="Shown" sourceRef="request_served" targetRef="see_the_rules_and_their_forecasts" />
    <bpmn:messageFlow id="messageflow_28" name="Rule settled" sourceRef="request_served" targetRef="see_the_rule_saved_or_the_reason_it_was_not" />
  </bpmn:collaboration>
