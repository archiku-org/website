<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="definitions" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:process id="process_owner">
    <bpmn:sendTask id="state_the_movement" name="State the movement" />
    <bpmn:startEvent id="money_has_moved" name="Money has moved" />
    <bpmn:receiveTask id="hear_the_outcome" name="Hear the outcome" />
    <bpmn:endEvent id="books_updated_or_plainly_refused" name="Books updated or plainly refused" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="money_has_moved" targetRef="state_the_movement" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="state_the_movement" targetRef="hear_the_outcome" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="hear_the_outcome" targetRef="books_updated_or_plainly_refused" />
  </bpmn:process>
  <bpmn:process id="process_entry_intake">
    <bpmn:scriptTask id="read_the_statement_as_given" name="Read the statement as given" />
    <bpmn:startEvent id="statement_arrives" name="Statement arrives" />
    <bpmn:exclusiveGateway id="statement_understood" name="Statement understood?" />
    <bpmn:userTask id="ask_for_what_the_statement_left_out" name="Ask for what the statement left out" />
    <bpmn:endEvent id="refused_as_unreadable" name="Refused as unreadable" />
    <bpmn:exclusiveGateway id="backed_out_at_a_question" name="Backed out at a question?" />
    <bpmn:exclusiveGateway id="dated_after_today" name="Dated after today?" />
    <bpmn:endEvent id="nothing_stored" name="Nothing stored" />
    <bpmn:exclusiveGateway id="the_statement_passes_admission" name="The statement passes admission?" />
    <bpmn:endEvent id="parked_as_a_promise" name="Parked as a promise" />
    <bpmn:sendTask id="hand_the_promise_to_the_expected_register" name="Hand the promise to the expected register" />
    <bpmn:exclusiveGateway id="a_rehearsal_was_asked" name="A rehearsal was asked?" />
    <bpmn:endEvent id="refused_with_the_reason" name="Refused with the reason" />
    <bpmn:sendTask id="hand_the_accepted_entry_to_the_mutation_layer" name="Hand the accepted entry to the mutation layer" />
    <bpmn:endEvent id="rehearsed_nothing_stored" name="Rehearsed, nothing stored" />
    <bpmn:task id="show_the_projected_balances" name="Show the projected balances" />
    <bpmn:receiveTask id="applied_entry_and_balances" name="Applied entry and balances" />
    <bpmn:endEvent id="entry_reported" name="Entry reported" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="statement_arrives" targetRef="read_the_statement_as_given" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="read_the_statement_as_given" targetRef="statement_understood" />
    <bpmn:sequenceFlow id="flow_6" name="No" sourceRef="statement_understood" targetRef="refused_as_unreadable" />
    <bpmn:sequenceFlow id="flow_7" name="Yes" sourceRef="statement_understood" targetRef="ask_for_what_the_statement_left_out" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="statement_understood" targetRef="ask_for_what_the_statement_left_out" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="ask_for_what_the_statement_left_out" targetRef="backed_out_at_a_question" />
    <bpmn:sequenceFlow id="flow_10" name="Yes" sourceRef="backed_out_at_a_question" targetRef="nothing_stored" />
    <bpmn:sequenceFlow id="flow_11" name="No" sourceRef="backed_out_at_a_question" targetRef="dated_after_today" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="backed_out_at_a_question" targetRef="dated_after_today" />
    <bpmn:sequenceFlow id="flow_13" sourceRef="hand_the_promise_to_the_expected_register" targetRef="parked_as_a_promise" />
    <bpmn:sequenceFlow id="flow_14" name="Yes" sourceRef="dated_after_today" targetRef="hand_the_promise_to_the_expected_register" />
    <bpmn:sequenceFlow id="flow_15" name="No" sourceRef="dated_after_today" targetRef="the_statement_passes_admission" />
    <bpmn:sequenceFlow id="flow_16" sourceRef="dated_after_today" targetRef="the_statement_passes_admission" />
    <bpmn:sequenceFlow id="flow_17" name="No" sourceRef="the_statement_passes_admission" targetRef="refused_with_the_reason" />
    <bpmn:sequenceFlow id="flow_18" name="Yes" sourceRef="the_statement_passes_admission" targetRef="a_rehearsal_was_asked" />
    <bpmn:sequenceFlow id="flow_19" sourceRef="the_statement_passes_admission" targetRef="a_rehearsal_was_asked" />
    <bpmn:sequenceFlow id="flow_20" sourceRef="show_the_projected_balances" targetRef="rehearsed_nothing_stored" />
    <bpmn:sequenceFlow id="flow_21" name="Yes" sourceRef="a_rehearsal_was_asked" targetRef="show_the_projected_balances" />
    <bpmn:sequenceFlow id="flow_22" name="No" sourceRef="a_rehearsal_was_asked" targetRef="hand_the_accepted_entry_to_the_mutation_layer" />
    <bpmn:sequenceFlow id="flow_23" sourceRef="a_rehearsal_was_asked" targetRef="hand_the_accepted_entry_to_the_mutation_layer" />
    <bpmn:sequenceFlow id="flow_24" sourceRef="hand_the_accepted_entry_to_the_mutation_layer" targetRef="applied_entry_and_balances" />
    <bpmn:sequenceFlow id="flow_25" sourceRef="applied_entry_and_balances" targetRef="entry_reported" />
  </bpmn:process>
  <bpmn:process id="process_command_mutations">
    <bpmn:task id="give_the_movement_its_identity" name="Give the movement its identity" />
    <bpmn:startEvent id="accepted_entry_arrives" name="Accepted entry arrives" />
    <bpmn:sendTask id="append_the_mutation_to_the_journal" name="Append the mutation to the journal" />
    <bpmn:receiveTask id="the_ledger_answered" name="The ledger answered" />
    <bpmn:endEvent id="landed_entry_returned" name="Landed entry returned" />
    <bpmn:sequenceFlow id="flow_26" sourceRef="accepted_entry_arrives" targetRef="give_the_movement_its_identity" />
    <bpmn:sequenceFlow id="flow_27" sourceRef="give_the_movement_its_identity" targetRef="append_the_mutation_to_the_journal" />
    <bpmn:sequenceFlow id="flow_28" sourceRef="append_the_mutation_to_the_journal" targetRef="the_ledger_answered" />
    <bpmn:sequenceFlow id="flow_29" sourceRef="the_ledger_answered" targetRef="landed_entry_returned" />
  </bpmn:process>
  <bpmn:process id="process_ledger_engine">
    <bpmn:task id="insert_the_row_at_its_date_position" name="Insert the row at its date position" />
    <bpmn:startEvent id="mutation_accepted" name="Mutation accepted" />
    <bpmn:task id="carry_the_balances_through_later_rows" name="Carry the balances through later rows" />
    <bpmn:endEvent id="row_landed_with_balances" name="Row landed with balances" />
    <bpmn:sequenceFlow id="flow_30" sourceRef="mutation_accepted" targetRef="insert_the_row_at_its_date_position" />
    <bpmn:sequenceFlow id="flow_31" sourceRef="insert_the_row_at_its_date_position" targetRef="carry_the_balances_through_later_rows" />
    <bpmn:sequenceFlow id="flow_32" sourceRef="carry_the_balances_through_later_rows" targetRef="row_landed_with_balances" />
  </bpmn:process>
  <bpmn:process id="process_expected_register">
    <bpmn:task id="park_the_promised_movement" name="Park the promised movement" />
    <bpmn:startEvent id="promise_arrives" name="Promise arrives" />
    <bpmn:endEvent id="promise_parked" name="Promise parked" />
    <bpmn:sequenceFlow id="flow_33" sourceRef="promise_arrives" targetRef="park_the_promised_movement" />
    <bpmn:sequenceFlow id="flow_34" sourceRef="park_the_promised_movement" targetRef="promise_parked" />
  </bpmn:process>
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="participant_owner" name="Owner" processRef="process_owner" />
    <bpmn:participant id="participant_entry_intake" name="Entry intake" processRef="process_entry_intake" />
    <bpmn:participant id="participant_command_mutations" name="Command mutations" processRef="process_command_mutations" />
    <bpmn:participant id="participant_ledger_engine" name="Ledger engine" processRef="process_ledger_engine" />
    <bpmn:participant id="participant_expected_register" name="Expected register" processRef="process_expected_register" />
    <bpmn:messageFlow id="messageflow_35" name="Movement statement" sourceRef="state_the_movement" targetRef="statement_arrives" />
    <bpmn:messageFlow id="messageflow_36" name="Stored entry and balances" sourceRef="entry_reported" targetRef="hear_the_outcome" />
    <bpmn:messageFlow id="messageflow_37" name="Refusal" sourceRef="refused_as_unreadable" targetRef="hear_the_outcome" />
    <bpmn:messageFlow id="messageflow_38" name="Refusal" sourceRef="refused_with_the_reason" targetRef="hear_the_outcome" />
    <bpmn:messageFlow id="messageflow_39" name="Abandoned" sourceRef="nothing_stored" targetRef="hear_the_outcome" />
    <bpmn:messageFlow id="messageflow_40" name="Rehearsal result" sourceRef="rehearsed_nothing_stored" targetRef="hear_the_outcome" />
    <bpmn:messageFlow id="messageflow_41" name="Promise" sourceRef="hand_the_promise_to_the_expected_register" targetRef="promise_arrives" />
    <bpmn:messageFlow id="messageflow_42" name="Promise parked" sourceRef="promise_parked" targetRef="hear_the_outcome" />
    <bpmn:messageFlow id="messageflow_43" name="Add request" sourceRef="hand_the_accepted_entry_to_the_mutation_layer" targetRef="accepted_entry_arrives" />
    <bpmn:messageFlow id="messageflow_44" name="Applied entry" sourceRef="landed_entry_returned" targetRef="applied_entry_and_balances" />
    <bpmn:messageFlow id="messageflow_45" name="Apply request" sourceRef="append_the_mutation_to_the_journal" targetRef="mutation_accepted" />
    <bpmn:messageFlow id="messageflow_46" name="Ledger result" sourceRef="row_landed_with_balances" targetRef="the_ledger_answered" />
  </bpmn:collaboration>
