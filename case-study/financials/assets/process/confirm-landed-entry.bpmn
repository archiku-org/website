<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="definitions" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:process id="process_owner">
    <bpmn:task id="pick_the_landed_entry_to_confirm" name="Pick the landed entry to confirm" />
    <bpmn:startEvent id="a_forecasted_movement_has_landed" name="A forecasted movement has landed" />
    <bpmn:sendTask id="hand_the_entry_to_the_books_for_confirmation" name="Hand the entry to the books for confirmation" />
    <bpmn:receiveTask id="receive_the_verdict_with_the_balances" name="Receive the verdict with the balances" />
    <bpmn:exclusiveGateway id="did_the_books_take_the_movement" name="Did the books take the movement?" />
    <bpmn:endEvent id="entry_stands_as_committed_history" name="Entry stands as committed history" />
    <bpmn:userTask id="adjust_the_entry_with_the_edit_flow" name="Adjust the entry with the edit flow" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="a_forecasted_movement_has_landed" targetRef="pick_the_landed_entry_to_confirm" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="pick_the_landed_entry_to_confirm" targetRef="hand_the_entry_to_the_books_for_confirmation" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="hand_the_entry_to_the_books_for_confirmation" targetRef="receive_the_verdict_with_the_balances" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="receive_the_verdict_with_the_balances" targetRef="did_the_books_take_the_movement" />
    <bpmn:sequenceFlow id="flow_5" name="Committed" sourceRef="did_the_books_take_the_movement" targetRef="entry_stands_as_committed_history" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="adjust_the_entry_with_the_edit_flow" targetRef="pick_the_landed_entry_to_confirm" />
    <bpmn:sequenceFlow id="flow_7" name="Not committed" sourceRef="did_the_books_take_the_movement" targetRef="adjust_the_entry_with_the_edit_flow" />
  </bpmn:process>
  <bpmn:process id="process_confirm_engine">
    <bpmn:scriptTask id="work_out_which_kind_of_open_entry_was_offered" name="Work out which kind of open entry was offered" />
    <bpmn:startEvent id="confirm_request_arrives" name="Confirm request arrives" />
    <bpmn:exclusiveGateway id="which_shape_is_the_open_entry" name="Which shape is the open entry?" />
    <bpmn:receiveTask id="receive_the_recorded_result" name="Receive the recorded result" />
    <bpmn:endEvent id="no_booking_made" name="No booking made" />
    <bpmn:sendTask id="answer_nothing_to_do_or_unknown_id" name="Answer nothing to do or unknown id" />
    <bpmn:exclusiveGateway id="landed_and_carrying_an_amount" name="Landed and carrying an amount?" />
    <bpmn:serviceTask id="drop_the_settled_expectation_from_the_register" name="Drop the settled expectation from the register" />
    <bpmn:serviceTask id="land_the_movement_and_retire_the_expectation_in_one_recorded_event" name="Land the movement and retire the expectation in one recorded event" />
    <bpmn:sendTask id="report_the_refusal_and_point_to_the_edit_flow" name="Report the refusal and point to the edit flow" />
    <bpmn:serviceTask id="carry_each_member_s_new_identity_into_the_group" name="Carry each member's new identity into the group" />
    <bpmn:scriptTask id="walk_the_landed_members_in_date_order_committing_each" name="Walk the landed members in date order, committing each" />
    <bpmn:serviceTask id="commit_the_occurrence_with_the_rule_s_own_values" name="Commit the occurrence with the rule's own values" />
    <bpmn:serviceTask id="commit_the_occurrence_with_the_confirmed_values" name="Commit the occurrence with the confirmed values" />
    <bpmn:userTask id="walk_the_owner_through_the_pre_filled_values" name="Walk the owner through the pre-filled values" />
    <bpmn:endEvent id="verdict_with_balances" name="Verdict with balances" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="confirm_request_arrives" targetRef="work_out_which_kind_of_open_entry_was_offered" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="work_out_which_kind_of_open_entry_was_offered" targetRef="which_shape_is_the_open_entry" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="answer_nothing_to_do_or_unknown_id" targetRef="no_booking_made" />
    <bpmn:sequenceFlow id="flow_11" name="Already committed or unknown id" sourceRef="which_shape_is_the_open_entry" targetRef="answer_nothing_to_do_or_unknown_id" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="land_the_movement_and_retire_the_expectation_in_one_recorded_event" targetRef="drop_the_settled_expectation_from_the_register" />
    <bpmn:sequenceFlow id="flow_13" sourceRef="drop_the_settled_expectation_from_the_register" targetRef="receive_the_recorded_result" />
    <bpmn:sequenceFlow id="flow_14" name="Yes" sourceRef="landed_and_carrying_an_amount" targetRef="land_the_movement_and_retire_the_expectation_in_one_recorded_event" />
    <bpmn:sequenceFlow id="flow_15" sourceRef="report_the_refusal_and_point_to_the_edit_flow" targetRef="no_booking_made" />
    <bpmn:sequenceFlow id="flow_16" name="No" sourceRef="landed_and_carrying_an_amount" targetRef="report_the_refusal_and_point_to_the_edit_flow" />
    <bpmn:sequenceFlow id="flow_17" sourceRef="landed_and_carrying_an_amount" targetRef="receive_the_recorded_result" />
    <bpmn:sequenceFlow id="flow_18" name="An expected entry" sourceRef="which_shape_is_the_open_entry" targetRef="landed_and_carrying_an_amount" />
    <bpmn:sequenceFlow id="flow_19" sourceRef="walk_the_landed_members_in_date_order_committing_each" targetRef="carry_each_member_s_new_identity_into_the_group" />
    <bpmn:sequenceFlow id="flow_20" sourceRef="carry_each_member_s_new_identity_into_the_group" targetRef="receive_the_recorded_result" />
    <bpmn:sequenceFlow id="flow_21" name="A whole statement group" sourceRef="which_shape_is_the_open_entry" targetRef="walk_the_landed_members_in_date_order_committing_each" />
    <bpmn:sequenceFlow id="flow_22" sourceRef="commit_the_occurrence_with_the_rule_s_own_values" targetRef="receive_the_recorded_result" />
    <bpmn:sequenceFlow id="flow_23" name="A landed rule occurrence" sourceRef="which_shape_is_the_open_entry" targetRef="commit_the_occurrence_with_the_rule_s_own_values" />
    <bpmn:sequenceFlow id="flow_24" sourceRef="walk_the_owner_through_the_pre_filled_values" targetRef="commit_the_occurrence_with_the_confirmed_values" />
    <bpmn:sequenceFlow id="flow_25" sourceRef="commit_the_occurrence_with_the_confirmed_values" targetRef="receive_the_recorded_result" />
    <bpmn:sequenceFlow id="flow_26" name="A rule occurrence still in the future" sourceRef="which_shape_is_the_open_entry" targetRef="walk_the_owner_through_the_pre_filled_values" />
    <bpmn:sequenceFlow id="flow_27" sourceRef="which_shape_is_the_open_entry" targetRef="receive_the_recorded_result" />
    <bpmn:sequenceFlow id="flow_28" sourceRef="receive_the_recorded_result" targetRef="verdict_with_balances" />
  </bpmn:process>
  <bpmn:process id="process_ledger_engine">
    <bpmn:serviceTask id="record_the_confirmed_movement" name="Record the confirmed movement" />
    <bpmn:startEvent id="commit_request_arrives" name="Commit request arrives" />
    <bpmn:serviceTask id="settle_the_account_balances" name="Settle the account balances" />
    <bpmn:sendTask id="return_the_verdict_with_the_balances" name="Return the verdict with the balances" />
    <bpmn:endEvent id="commit_settled" name="Commit settled" />
    <bpmn:sequenceFlow id="flow_29" sourceRef="commit_request_arrives" targetRef="record_the_confirmed_movement" />
    <bpmn:sequenceFlow id="flow_30" sourceRef="record_the_confirmed_movement" targetRef="settle_the_account_balances" />
    <bpmn:sequenceFlow id="flow_31" sourceRef="settle_the_account_balances" targetRef="return_the_verdict_with_the_balances" />
    <bpmn:sequenceFlow id="flow_32" sourceRef="return_the_verdict_with_the_balances" targetRef="commit_settled" />
  </bpmn:process>
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="participant_owner" name="Owner" processRef="process_owner" />
    <bpmn:participant id="participant_confirm_engine" name="Confirm engine" processRef="process_confirm_engine" />
    <bpmn:participant id="participant_ledger_engine" name="Ledger engine" processRef="process_ledger_engine" />
    <bpmn:messageFlow id="messageflow_33" name="Confirm request" sourceRef="hand_the_entry_to_the_books_for_confirmation" targetRef="confirm_request_arrives" />
    <bpmn:messageFlow id="messageflow_34" name="Expected commit" sourceRef="land_the_movement_and_retire_the_expectation_in_one_recorded_event" targetRef="commit_request_arrives" />
    <bpmn:messageFlow id="messageflow_35" name="Group member commits" sourceRef="walk_the_landed_members_in_date_order_committing_each" targetRef="commit_request_arrives" />
    <bpmn:messageFlow id="messageflow_36" name="Instance commit" sourceRef="commit_the_occurrence_with_the_rule_s_own_values" targetRef="commit_request_arrives" />
    <bpmn:messageFlow id="messageflow_37" name="Interactive commit" sourceRef="commit_the_occurrence_with_the_confirmed_values" targetRef="commit_request_arrives" />
    <bpmn:messageFlow id="messageflow_38" name="Recorded result" sourceRef="return_the_verdict_with_the_balances" targetRef="receive_the_recorded_result" />
    <bpmn:messageFlow id="messageflow_39" name="Confirmation verdict" sourceRef="verdict_with_balances" targetRef="receive_the_verdict_with_the_balances" />
    <bpmn:messageFlow id="messageflow_40" name="Refusal" sourceRef="report_the_refusal_and_point_to_the_edit_flow" targetRef="receive_the_verdict_with_the_balances" />
    <bpmn:messageFlow id="messageflow_41" name="Nothing-to-do answer" sourceRef="answer_nothing_to_do_or_unknown_id" targetRef="receive_the_verdict_with_the_balances" />
  </bpmn:collaboration>
