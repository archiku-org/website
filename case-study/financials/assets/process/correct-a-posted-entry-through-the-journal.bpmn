<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="definitions" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:process id="process_owner">
    <bpmn:userTask id="pick_the_entry_to_correct" name="Pick the entry to correct" />
    <bpmn:startEvent id="a_posted_entry_shows_a_mistake" name="A posted entry shows a mistake" />
    <bpmn:sendTask id="correction_request" name="Correction request" />
    <bpmn:receiveTask id="correction_outcome" name="Correction outcome" />
    <bpmn:endEvent id="books_corrected" name="Books corrected" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="a_posted_entry_shows_a_mistake" targetRef="pick_the_entry_to_correct" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="pick_the_entry_to_correct" targetRef="correction_request" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="correction_request" targetRef="correction_outcome" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="correction_outcome" targetRef="books_corrected" />
  </bpmn:process>
  <bpmn:process id="process_entry_editor">
    <bpmn:userTask id="review_the_entry_field_by_field" name="Review the entry field by field" />
    <bpmn:startEvent id="correction_requested" name="Correction requested" />
    <bpmn:exclusiveGateway id="which_register_holds_the_entry" name="Which register holds the entry?" />
    <bpmn:receiveTask id="write_accepted" name="Write accepted" />
    <bpmn:sendTask id="land_the_corrective_record" name="Land the corrective record" />
    <bpmn:exclusiveGateway id="restated_day_after_today" name="Restated day after today?" />
    <bpmn:sendTask id="reserve_the_corrected_row_as_a_promise" name="Reserve the corrected row as a promise" />
    <bpmn:sendTask id="back_the_row_out_of_the_books" name="Back the row out of the books" />
    <bpmn:exclusiveGateway id="reservation_refused" name="Reservation refused?" />
    <bpmn:endEvent id="row_left_unreplaced" name="Row left unreplaced" />
    <bpmn:task id="leave_the_recovery_to_the_owner" name="Leave the recovery to the owner" />
    <bpmn:task id="report_the_completed_move" name="Report the completed move" />
    <bpmn:exclusiveGateway id="day_already_arrived" name="Day already arrived?" />
    <bpmn:task id="retire_the_promise_from_the_register" name="Retire the promise from the register" />
    <bpmn:sendTask id="confirm_the_restated_promise_into_the_books" name="Confirm the restated promise into the books" />
    <bpmn:task id="restate_the_promise_where_it_stands" name="Restate the promise where it stands" />
    <bpmn:endEvent id="corrected_elsewhere" name="Corrected elsewhere" />
    <bpmn:task id="open_the_group_or_occurrence_editor" name="Open the group or occurrence editor" />
    <bpmn:endEvent id="nothing_changed" name="Nothing changed" />
    <bpmn:task id="refuse_the_unknown_address" name="Refuse the unknown address" />
    <bpmn:userTask id="report_the_outcome" name="Report the outcome" />
    <bpmn:endEvent id="correction_finished" name="Correction finished" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="correction_requested" targetRef="review_the_entry_field_by_field" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="review_the_entry_field_by_field" targetRef="which_register_holds_the_entry" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="back_the_row_out_of_the_books" targetRef="reserve_the_corrected_row_as_a_promise" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="reserve_the_corrected_row_as_a_promise" targetRef="reservation_refused" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="leave_the_recovery_to_the_owner" targetRef="row_left_unreplaced" />
    <bpmn:sequenceFlow id="flow_10" name="Yes" sourceRef="reservation_refused" targetRef="leave_the_recovery_to_the_owner" />
    <bpmn:sequenceFlow id="flow_11" sourceRef="report_the_completed_move" targetRef="write_accepted" />
    <bpmn:sequenceFlow id="flow_12" name="No" sourceRef="reservation_refused" targetRef="report_the_completed_move" />
    <bpmn:sequenceFlow id="flow_13" sourceRef="reservation_refused" targetRef="land_the_corrective_record" />
    <bpmn:sequenceFlow id="flow_14" name="Yes" sourceRef="restated_day_after_today" targetRef="back_the_row_out_of_the_books" />
    <bpmn:sequenceFlow id="flow_15" name="No" sourceRef="restated_day_after_today" targetRef="land_the_corrective_record" />
    <bpmn:sequenceFlow id="flow_16" sourceRef="restated_day_after_today" targetRef="land_the_corrective_record" />
    <bpmn:sequenceFlow id="flow_17" sourceRef="land_the_corrective_record" targetRef="write_accepted" />
    <bpmn:sequenceFlow id="flow_18" name="The books" sourceRef="which_register_holds_the_entry" targetRef="restated_day_after_today" />
    <bpmn:sequenceFlow id="flow_19" sourceRef="confirm_the_restated_promise_into_the_books" targetRef="retire_the_promise_from_the_register" />
    <bpmn:sequenceFlow id="flow_20" sourceRef="retire_the_promise_from_the_register" targetRef="write_accepted" />
    <bpmn:sequenceFlow id="flow_21" name="Yes" sourceRef="day_already_arrived" targetRef="confirm_the_restated_promise_into_the_books" />
    <bpmn:sequenceFlow id="flow_22" sourceRef="restate_the_promise_where_it_stands" targetRef="write_accepted" />
    <bpmn:sequenceFlow id="flow_23" name="No" sourceRef="day_already_arrived" targetRef="restate_the_promise_where_it_stands" />
    <bpmn:sequenceFlow id="flow_24" sourceRef="day_already_arrived" targetRef="write_accepted" />
    <bpmn:sequenceFlow id="flow_25" name="The promises register" sourceRef="which_register_holds_the_entry" targetRef="day_already_arrived" />
    <bpmn:sequenceFlow id="flow_26" sourceRef="open_the_group_or_occurrence_editor" targetRef="corrected_elsewhere" />
    <bpmn:sequenceFlow id="flow_27" name="A group or a standing rule" sourceRef="which_register_holds_the_entry" targetRef="open_the_group_or_occurrence_editor" />
    <bpmn:sequenceFlow id="flow_28" sourceRef="refuse_the_unknown_address" targetRef="nothing_changed" />
    <bpmn:sequenceFlow id="flow_29" name="Unresolvable address" sourceRef="which_register_holds_the_entry" targetRef="refuse_the_unknown_address" />
    <bpmn:sequenceFlow id="flow_30" sourceRef="which_register_holds_the_entry" targetRef="write_accepted" />
    <bpmn:sequenceFlow id="flow_31" sourceRef="write_accepted" targetRef="report_the_outcome" />
    <bpmn:sequenceFlow id="flow_32" sourceRef="report_the_outcome" targetRef="correction_finished" />
  </bpmn:process>
  <bpmn:process id="process_command_mutations">
    <bpmn:serviceTask id="append_the_corrective_mutation" name="Append the corrective mutation" />
    <bpmn:startEvent id="write_requested" name="Write requested" />
    <bpmn:serviceTask id="refold_the_balance_chain" name="Refold the balance chain" />
    <bpmn:endEvent id="journal_converged" name="Journal converged" />
    <bpmn:sequenceFlow id="flow_33" sourceRef="write_requested" targetRef="append_the_corrective_mutation" />
    <bpmn:sequenceFlow id="flow_34" sourceRef="append_the_corrective_mutation" targetRef="refold_the_balance_chain" />
    <bpmn:sequenceFlow id="flow_35" sourceRef="refold_the_balance_chain" targetRef="journal_converged" />
  </bpmn:process>
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="participant_owner" name="Owner" processRef="process_owner" />
    <bpmn:participant id="participant_entry_editor" name="Entry editor" processRef="process_entry_editor" />
    <bpmn:participant id="participant_command_mutations" name="Command mutations" processRef="process_command_mutations" />
    <bpmn:messageFlow id="messageflow_36" name="Edit request" sourceRef="correction_request" targetRef="correction_requested" />
    <bpmn:messageFlow id="messageflow_37" name="Row back-out" sourceRef="back_the_row_out_of_the_books" targetRef="write_requested" />
    <bpmn:messageFlow id="messageflow_38" name="Promise reservation" sourceRef="reserve_the_corrected_row_as_a_promise" targetRef="write_requested" />
    <bpmn:messageFlow id="messageflow_39" name="Committed correction" sourceRef="land_the_corrective_record" targetRef="write_requested" />
    <bpmn:messageFlow id="messageflow_40" name="Landed promise commits" sourceRef="confirm_the_restated_promise_into_the_books" targetRef="write_requested" />
    <bpmn:messageFlow id="messageflow_41" name="Write result" sourceRef="journal_converged" targetRef="write_accepted" />
    <bpmn:messageFlow id="messageflow_42" name="Correction result" sourceRef="report_the_outcome" targetRef="correction_outcome" />
  </bpmn:collaboration>
