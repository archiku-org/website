<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="definitions" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:process id="process_owner">
    <bpmn:userTask id="ask_which_payments_repeat" name="Ask which payments repeat" />
    <bpmn:startEvent id="spots_a_repeating_payment" name="Spots a repeating payment" />
    <bpmn:receiveTask id="read_the_proposal_list" name="Read the proposal list" />
    <bpmn:userTask id="name_a_proposal_to_adopt" name="Name a proposal to adopt" />
    <bpmn:exclusiveGateway id="adoption_completed_or_abandoned" name="Adoption completed or abandoned?" />
    <bpmn:endEvent id="repeating_payment_decided" name="Repeating payment decided" />
    <bpmn:receiveTask id="read_that_nothing_was_stored" name="Read that nothing was stored" />
    <bpmn:receiveTask id="read_the_rule_s_next_dates" name="Read the rule's next dates" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="spots_a_repeating_payment" targetRef="ask_which_payments_repeat" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="ask_which_payments_repeat" targetRef="read_the_proposal_list" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="read_the_proposal_list" targetRef="name_a_proposal_to_adopt" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="name_a_proposal_to_adopt" targetRef="adoption_completed_or_abandoned" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="read_that_nothing_was_stored" targetRef="repeating_payment_decided" />
    <bpmn:sequenceFlow id="flow_6" name="Nothing was saved" sourceRef="adoption_completed_or_abandoned" targetRef="read_that_nothing_was_stored" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="read_the_rule_s_next_dates" targetRef="repeating_payment_decided" />
    <bpmn:sequenceFlow id="flow_8" name="The rule was saved" sourceRef="adoption_completed_or_abandoned" targetRef="read_the_rule_s_next_dates" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="adoption_completed_or_abandoned" targetRef="repeating_payment_decided" />
  </bpmn:process>
  <bpmn:process id="process_recurrence_planner">
    <bpmn:businessRuleTask id="re_derive_proposal_candidates_from_the_ledger_history" name="Re-derive proposal candidates from the ledger history" />
    <bpmn:startEvent id="history_question_arrives" name="History question arrives" />
    <bpmn:exclusiveGateway id="review_list_or_numbered_adoption" name="Review list or numbered adoption?" />
    <bpmn:endEvent id="run_done" name="Run done" />
    <bpmn:exclusiveGateway id="quit_key_pressed_at_a_field" name="Quit key pressed at a field?" />
    <bpmn:userTask id="seed_every_field_with_the_detected_value" name="Seed every field with the detected value" />
    <bpmn:businessRuleTask id="check_the_completed_rule_against_the_admission_bars" name="Check the completed rule against the admission bars" />
    <bpmn:endEvent id="adoption_abandoned" name="Adoption abandoned" />
    <bpmn:sendTask id="report_that_nothing_was_stored" name="Report that nothing was stored" />
    <bpmn:exclusiveGateway id="rule_admissible" name="Rule admissible?" />
    <bpmn:task id="save_the_rule_into_the_standing_schedules" name="Save the rule into the standing schedules" />
    <bpmn:endEvent id="adoption_refused" name="Adoption refused" />
    <bpmn:sendTask id="report_the_refusal_with_its_reason" name="Report the refusal with its reason" />
    <bpmn:sendTask id="show_the_rule_s_next_three_anticipated_dates" name="Show the rule's next three anticipated dates" />
    <bpmn:sendTask id="present_the_review_only_proposal_list" name="Present the review-only proposal list" />
    <bpmn:exclusiveGateway id="proposal_number_still_on_the_list" name="Proposal number still on the list?" />
    <bpmn:endEvent id="adoption_never_opened" name="Adoption never opened" />
    <bpmn:sendTask id="report_that_the_proposal_is_no_longer_there" name="Report that the proposal is no longer there" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="history_question_arrives" targetRef="re_derive_proposal_candidates_from_the_ledger_history" />
    <bpmn:sequenceFlow id="flow_11" sourceRef="re_derive_proposal_candidates_from_the_ledger_history" targetRef="review_list_or_numbered_adoption" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="seed_every_field_with_the_detected_value" targetRef="quit_key_pressed_at_a_field" />
    <bpmn:sequenceFlow id="flow_13" sourceRef="report_that_nothing_was_stored" targetRef="adoption_abandoned" />
    <bpmn:sequenceFlow id="flow_14" name="Quit" sourceRef="quit_key_pressed_at_a_field" targetRef="report_that_nothing_was_stored" />
    <bpmn:sequenceFlow id="flow_15" name="Every field completed" sourceRef="quit_key_pressed_at_a_field" targetRef="check_the_completed_rule_against_the_admission_bars" />
    <bpmn:sequenceFlow id="flow_16" sourceRef="quit_key_pressed_at_a_field" targetRef="check_the_completed_rule_against_the_admission_bars" />
    <bpmn:sequenceFlow id="flow_17" sourceRef="check_the_completed_rule_against_the_admission_bars" targetRef="rule_admissible" />
    <bpmn:sequenceFlow id="flow_18" sourceRef="report_the_refusal_with_its_reason" targetRef="adoption_refused" />
    <bpmn:sequenceFlow id="flow_19" name="Refused" sourceRef="rule_admissible" targetRef="report_the_refusal_with_its_reason" />
    <bpmn:sequenceFlow id="flow_20" name="Admissible" sourceRef="rule_admissible" targetRef="save_the_rule_into_the_standing_schedules" />
    <bpmn:sequenceFlow id="flow_21" sourceRef="rule_admissible" targetRef="save_the_rule_into_the_standing_schedules" />
    <bpmn:sequenceFlow id="flow_22" sourceRef="save_the_rule_into_the_standing_schedules" targetRef="show_the_rule_s_next_three_anticipated_dates" />
    <bpmn:sequenceFlow id="flow_23" sourceRef="show_the_rule_s_next_three_anticipated_dates" targetRef="run_done" />
    <bpmn:sequenceFlow id="flow_24" sourceRef="review_list_or_numbered_adoption" targetRef="seed_every_field_with_the_detected_value" />
    <bpmn:sequenceFlow id="flow_25" sourceRef="present_the_review_only_proposal_list" targetRef="run_done" />
    <bpmn:sequenceFlow id="flow_26" name="Owner wants the review list" sourceRef="review_list_or_numbered_adoption" targetRef="present_the_review_only_proposal_list" />
    <bpmn:sequenceFlow id="flow_27" sourceRef="report_that_the_proposal_is_no_longer_there" targetRef="adoption_never_opened" />
    <bpmn:sequenceFlow id="flow_28" name="Gone" sourceRef="proposal_number_still_on_the_list" targetRef="report_that_the_proposal_is_no_longer_there" />
    <bpmn:sequenceFlow id="flow_29" name="On the list" sourceRef="proposal_number_still_on_the_list" targetRef="run_done" />
    <bpmn:sequenceFlow id="flow_30" sourceRef="proposal_number_still_on_the_list" targetRef="run_done" />
    <bpmn:sequenceFlow id="flow_31" name="Owner adopts a numbered proposal" sourceRef="review_list_or_numbered_adoption" targetRef="proposal_number_still_on_the_list" />
  </bpmn:process>
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="participant_owner" name="Owner" processRef="process_owner" />
    <bpmn:participant id="participant_recurrence_planner" name="Recurrence planner" processRef="process_recurrence_planner" />
    <bpmn:messageFlow id="messageflow_32" name="Review request" sourceRef="ask_which_payments_repeat" targetRef="history_question_arrives" />
    <bpmn:messageFlow id="messageflow_33" name="Adoption request" sourceRef="name_a_proposal_to_adopt" targetRef="history_question_arrives" />
    <bpmn:messageFlow id="messageflow_34" name="Proposal list" sourceRef="present_the_review_only_proposal_list" targetRef="read_the_proposal_list" />
    <bpmn:messageFlow id="messageflow_35" name="Gone notice" sourceRef="report_that_the_proposal_is_no_longer_there" targetRef="read_that_nothing_was_stored" />
    <bpmn:messageFlow id="messageflow_36" name="Abort notice" sourceRef="report_that_nothing_was_stored" targetRef="read_that_nothing_was_stored" />
    <bpmn:messageFlow id="messageflow_37" name="Refusal notice" sourceRef="report_the_refusal_with_its_reason" targetRef="read_that_nothing_was_stored" />
    <bpmn:messageFlow id="messageflow_38" name="Upcoming schedule" sourceRef="show_the_rule_s_next_three_anticipated_dates" targetRef="read_the_rule_s_next_dates" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="collaboration">
