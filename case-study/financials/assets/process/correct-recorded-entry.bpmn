<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="definitions" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:process id="process_owner">
    <bpmn:userTask id="name_the_entry_to_correct_or_pick_it_from_the_ten_most_recent_rows" name="Name the entry to correct or pick it from the ten most recent rows" />
    <bpmn:startEvent id="a_recorded_entry_turns_out_wrong" name="A recorded entry turns out wrong" />
    <bpmn:receiveTask id="see_the_outcome_and_the_updated_balances" name="See the outcome and the updated balances" />
    <bpmn:endEvent id="entry_corrected" name="Entry corrected" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="a_recorded_entry_turns_out_wrong" targetRef="name_the_entry_to_correct_or_pick_it_from_the_ten_most_recent_rows" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="name_the_entry_to_correct_or_pick_it_from_the_ten_most_recent_rows" targetRef="see_the_outcome_and_the_updated_balances" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="see_the_outcome_and_the_updated_balances" targetRef="entry_corrected" />
  </bpmn:process>
  <bpmn:process id="process_financials_program">
    <bpmn:task id="resolve_the_named_id_against_the_ledger_expectations_groups_and_rule_occurrences" name="Resolve the named id against the ledger, expectations, groups and rule occurrences" />
    <bpmn:startEvent id="edit_request_arrives" name="Edit request arrives" />
    <bpmn:exclusiveGateway id="what_kind_of_entry_was_named" name="What kind of entry was named?" />
    <bpmn:userTask id="report_the_outcome_and_the_updated_balances" name="Report the outcome and the updated balances" />
    <bpmn:exclusiveGateway id="does_the_corrected_date_move_the_row_ahead_of_today" name="Does the corrected date move the row ahead of today?" />
    <bpmn:userTask id="walk_the_committed_row_s_pre_filled_prompts_with_the_owner" name="Walk the committed row's pre-filled prompts with the owner" />
    <bpmn:task id="recreate_the_entry_as_an_expectation_at_the_new_date" name="Recreate the entry as an expectation at the new date" />
    <bpmn:task id="remove_the_committed_row_from_the_ledger_journaled" name="Remove the committed row from the ledger, journaled" />
    <bpmn:task id="record_the_correction_as_a_journaled_update_replay_checked" name="Record the correction as a journaled update, replay-checked" />
    <bpmn:exclusiveGateway id="has_the_expectation_landed_on_or_before_today" name="Has the expectation landed on or before today?" />
    <bpmn:userTask id="walk_the_expectation_s_pre_filled_prompts_with_the_owner" name="Walk the expectation's pre-filled prompts with the owner" />
    <bpmn:task id="confirm_the_entry_as_a_real_transaction_retiring_the_expectation_replay_checked" name="Confirm the entry as a real transaction, retiring the expectation, replay-checked" />
    <bpmn:task id="update_the_expectation_in_the_register" name="Update the expectation in the register" />
    <bpmn:task id="update_the_group_s_name_rollup_date_category_and_note" name="Update the group's name, rollup date, category and note" />
    <bpmn:userTask id="walk_the_group_s_pre_filled_relabel_prompts_with_the_owner" name="Walk the group's pre-filled relabel prompts with the owner" />
    <bpmn:exclusiveGateway id="what_did_the_owner_choose" name="What did the owner choose?" />
    <bpmn:userTask id="ask_the_owner_adjust_the_whole_rule_or_handle_only_this_occurrence" name="Ask the owner: adjust the whole rule or handle only this occurrence" />
    <bpmn:task id="open_the_recurring_rule_s_editor" name="Open the recurring rule's editor" />
    <bpmn:exclusiveGateway id="has_the_occurrence_landed" name="Has the occurrence landed?" />
    <bpmn:task id="confirm_the_occurrence_as_a_real_transaction_replay_checked" name="Confirm the occurrence as a real transaction, replay-checked" />
    <bpmn:task id="record_the_deviation_as_an_expectation_and_exempt_this_occurrence" name="Record the deviation as an expectation and exempt this occurrence" />
    <bpmn:task id="tell_the_owner_the_id_was_not_recognised" name="Tell the owner the id was not recognised" />
    <bpmn:endEvent id="correction_handled" name="Correction handled" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="edit_request_arrives" targetRef="resolve_the_named_id_against_the_ledger_expectations_groups_and_rule_occurrences" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="resolve_the_named_id_against_the_ledger_expectations_groups_and_rule_occurrences" targetRef="what_kind_of_entry_was_named" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="walk_the_committed_row_s_pre_filled_prompts_with_the_owner" targetRef="does_the_corrected_date_move_the_row_ahead_of_today" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="remove_the_committed_row_from_the_ledger_journaled" targetRef="recreate_the_entry_as_an_expectation_at_the_new_date" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="recreate_the_entry_as_an_expectation_at_the_new_date" targetRef="report_the_outcome_and_the_updated_balances" />
    <bpmn:sequenceFlow id="flow_9" name="Ahead of today" sourceRef="does_the_corrected_date_move_the_row_ahead_of_today" targetRef="remove_the_committed_row_from_the_ledger_journaled" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="record_the_correction_as_a_journaled_update_replay_checked" targetRef="report_the_outcome_and_the_updated_balances" />
    <bpmn:sequenceFlow id="flow_11" name="Today or earlier" sourceRef="does_the_corrected_date_move_the_row_ahead_of_today" targetRef="record_the_correction_as_a_journaled_update_replay_checked" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="does_the_corrected_date_move_the_row_ahead_of_today" targetRef="report_the_outcome_and_the_updated_balances" />
    <bpmn:sequenceFlow id="flow_13" name="Committed row" sourceRef="what_kind_of_entry_was_named" targetRef="walk_the_committed_row_s_pre_filled_prompts_with_the_owner" />
    <bpmn:sequenceFlow id="flow_14" sourceRef="walk_the_expectation_s_pre_filled_prompts_with_the_owner" targetRef="has_the_expectation_landed_on_or_before_today" />
    <bpmn:sequenceFlow id="flow_15" sourceRef="confirm_the_entry_as_a_real_transaction_retiring_the_expectation_replay_checked" targetRef="report_the_outcome_and_the_updated_balances" />
    <bpmn:sequenceFlow id="flow_16" name="Landed today or earlier" sourceRef="has_the_expectation_landed_on_or_before_today" targetRef="confirm_the_entry_as_a_real_transaction_retiring_the_expectation_replay_checked" />
    <bpmn:sequenceFlow id="flow_17" sourceRef="update_the_expectation_in_the_register" targetRef="report_the_outcome_and_the_updated_balances" />
    <bpmn:sequenceFlow id="flow_18" name="Still open" sourceRef="has_the_expectation_landed_on_or_before_today" targetRef="update_the_expectation_in_the_register" />
    <bpmn:sequenceFlow id="flow_19" sourceRef="has_the_expectation_landed_on_or_before_today" targetRef="report_the_outcome_and_the_updated_balances" />
    <bpmn:sequenceFlow id="flow_20" name="Expectation" sourceRef="what_kind_of_entry_was_named" targetRef="walk_the_expectation_s_pre_filled_prompts_with_the_owner" />
    <bpmn:sequenceFlow id="flow_21" sourceRef="walk_the_group_s_pre_filled_relabel_prompts_with_the_owner" targetRef="update_the_group_s_name_rollup_date_category_and_note" />
    <bpmn:sequenceFlow id="flow_22" sourceRef="update_the_group_s_name_rollup_date_category_and_note" targetRef="report_the_outcome_and_the_updated_balances" />
    <bpmn:sequenceFlow id="flow_23" name="Statement group" sourceRef="what_kind_of_entry_was_named" targetRef="walk_the_group_s_pre_filled_relabel_prompts_with_the_owner" />
    <bpmn:sequenceFlow id="flow_24" sourceRef="ask_the_owner_adjust_the_whole_rule_or_handle_only_this_occurrence" targetRef="what_did_the_owner_choose" />
    <bpmn:sequenceFlow id="flow_25" sourceRef="open_the_recurring_rule_s_editor" targetRef="report_the_outcome_and_the_updated_balances" />
    <bpmn:sequenceFlow id="flow_26" name="Adjust the rule" sourceRef="what_did_the_owner_choose" targetRef="open_the_recurring_rule_s_editor" />
    <bpmn:sequenceFlow id="flow_27" sourceRef="confirm_the_occurrence_as_a_real_transaction_replay_checked" targetRef="report_the_outcome_and_the_updated_balances" />
    <bpmn:sequenceFlow id="flow_28" name="Landed" sourceRef="has_the_occurrence_landed" targetRef="confirm_the_occurrence_as_a_real_transaction_replay_checked" />
    <bpmn:sequenceFlow id="flow_29" sourceRef="record_the_deviation_as_an_expectation_and_exempt_this_occurrence" targetRef="report_the_outcome_and_the_updated_balances" />
    <bpmn:sequenceFlow id="flow_30" name="Still ahead" sourceRef="has_the_occurrence_landed" targetRef="record_the_deviation_as_an_expectation_and_exempt_this_occurrence" />
    <bpmn:sequenceFlow id="flow_31" sourceRef="has_the_occurrence_landed" targetRef="report_the_outcome_and_the_updated_balances" />
    <bpmn:sequenceFlow id="flow_32" name="This occurrence only" sourceRef="what_did_the_owner_choose" targetRef="has_the_occurrence_landed" />
    <bpmn:sequenceFlow id="flow_33" sourceRef="what_did_the_owner_choose" targetRef="report_the_outcome_and_the_updated_balances" />
    <bpmn:sequenceFlow id="flow_34" name="Projected occurrence" sourceRef="what_kind_of_entry_was_named" targetRef="ask_the_owner_adjust_the_whole_rule_or_handle_only_this_occurrence" />
    <bpmn:sequenceFlow id="flow_35" sourceRef="tell_the_owner_the_id_was_not_recognised" targetRef="report_the_outcome_and_the_updated_balances" />
    <bpmn:sequenceFlow id="flow_36" name="Unknown id" sourceRef="what_kind_of_entry_was_named" targetRef="tell_the_owner_the_id_was_not_recognised" />
    <bpmn:sequenceFlow id="flow_37" sourceRef="what_kind_of_entry_was_named" targetRef="report_the_outcome_and_the_updated_balances" />
    <bpmn:sequenceFlow id="flow_38" sourceRef="report_the_outcome_and_the_updated_balances" targetRef="correction_handled" />
  </bpmn:process>
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="participant_owner" name="Owner" processRef="process_owner" />
