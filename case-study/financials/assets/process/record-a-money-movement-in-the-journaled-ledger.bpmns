process "Owner"
  start "Money has moved"
  send "State the movement"
  receive "Hear the outcome"
  end "Books updated or plainly refused"

process "Entry intake"
  start "Statement arrives"
  script "Read the statement as given"
  exclusive "Statement understood?"
    if "No" then end "Refused as unreadable"
    else "Yes"
  user "Ask for what the statement left out"
  exclusive "Backed out at a question?"
    if "Yes" then end "Nothing stored"
    else "No"
  exclusive "Dated after today?"
    if "Yes" then
      send "Hand the promise to the expected register"
      end "Parked as a promise"
    else "No"
  exclusive "The statement passes admission?"
    if "No" then end "Refused with the reason"
    else "Yes"
  exclusive "A rehearsal was asked?"
    if "Yes" then
      task "Show the projected balances"
      end "Rehearsed, nothing stored"
    else "No"
  send "Hand the accepted entry to the mutation layer"
  receive "Applied entry and balances"
  end "Entry reported"

process "Command mutations"
  start "Accepted entry arrives"
  task "Give the movement its identity"
  send "Append the mutation to the journal"
  receive "The ledger answered"
  end "Landed entry returned"

process "Ledger engine"
  start "Mutation accepted"
  task "Insert the row at its date position"
  task "Carry the balances through later rows"
  end "Row landed with balances"

process "Expected register"
  start "Promise arrives"
  task "Park the promised movement"
  end "Promise parked"

message flows
  from "Owner"."State the movement" to "Entry intake"."Statement arrives" label "Movement statement"
  from "Entry intake"."Entry reported" to "Owner"."Hear the outcome" label "Stored entry and balances"
  from "Entry intake"."Refused as unreadable" to "Owner"."Hear the outcome" label "Refusal"
  from "Entry intake"."Refused with the reason" to "Owner"."Hear the outcome" label "Refusal"
  from "Entry intake"."Nothing stored" to "Owner"."Hear the outcome" label "Abandoned"
  from "Entry intake"."Rehearsed, nothing stored" to "Owner"."Hear the outcome" label "Rehearsal result"
  from "Entry intake"."Hand the promise to the expected register" to "Expected register"."Promise arrives" label "Promise"
  from "Expected register"."Promise parked" to "Owner"."Hear the outcome" label "Promise parked"
  from "Entry intake"."Hand the accepted entry to the mutation layer" to "Command mutations"."Accepted entry arrives" label "Add request"
  from "Command mutations"."Landed entry returned" to "Entry intake"."Applied entry and balances" label "Applied entry"
  from "Command mutations"."Append the mutation to the journal" to "Ledger engine"."Mutation accepted" label "Apply request"
  from "Ledger engine"."Row landed with balances" to "Command mutations"."The ledger answered" label "Ledger result"

