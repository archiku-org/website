<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="definitions" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:process id="process_owner">
    <bpmn:userTask id="decide_to_bring_the_open_item_into_the_books" name="Decide to bring the open item into the books" />
    <bpmn:startEvent id="landed_money_waits_to_be_accepted" name="Landed money waits to be accepted" />
    <bpmn:sendTask id="name_the_open_item_to_confirm" name="Name the open item to confirm" />
    <bpmn:receiveTask id="take_the_desk_s_answer" name="Take the desk's answer" />
    <bpmn:endEvent id="the_landed_movement_is_settled_in_the_books" name="The landed movement is settled in the books" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="landed_money_waits_to_be_accepted" targetRef="decide_to_bring_the_open_item_into_the_books" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="decide_to_bring_the_open_item_into_the_books" targetRef="name_the_open_item_to_confirm" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="name_the_open_item_to_confirm" targetRef="take_the_desk_s_answer" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="take_the_desk_s_answer" targetRef="the_landed_movement_is_settled_in_the_books" />
  </bpmn:process>
  <bpmn:process id="process_open_entry_confirmation">
    <bpmn:exclusiveGateway id="is_an_open_item_named" name="Is an open item named?" />
    <bpmn:startEvent id="confirm_request_arrives" name="Confirm request arrives" />
    <bpmn:serviceTask id="resolve_the_open_item_from_register_or_standing_rule" name="Resolve the open item from register or standing rule" />
    <bpmn:userTask id="pick_an_open_item_or_cancel" name="Pick an open item or cancel" />
    <bpmn:serviceTask id="compose_the_landed_open_list" name="Compose the landed open list" />
    <bpmn:exclusiveGateway id="was_an_item_picked" name="Was an item picked?" />
    <bpmn:endEvent id="nothing_confirmed" name="Nothing confirmed" />
    <bpmn:exclusiveGateway id="does_the_item_still_lie_ahead_of_today" name="Does the item still lie ahead of today?" />
    <bpmn:exclusiveGateway id="does_the_item_carry_its_amount" name="Does the item carry its amount?" />
    <bpmn:endEvent id="the_open_item_stays_open" name="The open item stays open" />
    <bpmn:sendTask id="refuse_to_confirm_money_that_has_not_moved" name="Refuse to confirm money that has not moved" />
    <bpmn:exclusiveGateway id="is_the_open_item_a_group" name="Is the open item a group?" />
    <bpmn:endEvent id="the_item_without_amount_stays_open" name="The item without amount stays open" />
    <bpmn:sendTask id="refuse_to_confirm_a_movement_with_no_amount" name="Refuse to confirm a movement with no amount" />
    <bpmn:serviceTask id="commit_the_item_as_an_actual_journal_posting" name="Commit the item as an actual journal posting" />
    <bpmn:exclusiveGateway id="did_any_member_land" name="Did any member land?" />
    <bpmn:serviceTask id="collect_the_group_s_landed_members_in_day_order" name="Collect the group's landed members in day order" />
    <bpmn:serviceTask id="retire_the_member_s_open_item_and_re_point_its_address" name="Retire the member's open item and re-point its address" />
    <bpmn:serviceTask id="commit_the_next_landed_member_as_an_actual_posting" name="Commit the next landed member as an actual posting" />
    <bpmn:exclusiveGateway id="more_landed_members_pending" name="More landed members pending?" />
    <bpmn:endEvent id="the_group_stands_as_it_was" name="The group stands as it was" />
    <bpmn:serviceTask id="retire_the_open_item_behind_the_posting" name="Retire the open item behind the posting" />
    <bpmn:exclusiveGateway id="did_the_posting_drift_from_its_standing_rule" name="Did the posting drift from its standing rule?" />
    <bpmn:sendTask id="report_the_outcome_with_the_new_account_state" name="Report the outcome with the new account state" />
    <bpmn:serviceTask id="record_the_occurrence_as_an_exception" name="Record the occurrence as an exception" />
    <bpmn:endEvent id="open_item_committed" name="Open item committed" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="confirm_request_arrives" targetRef="is_an_open_item_named" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="compose_the_landed_open_list" targetRef="pick_an_open_item_or_cancel" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="pick_an_open_item_or_cancel" targetRef="was_an_item_picked" />
    <bpmn:sequenceFlow id="flow_8" name="No" sourceRef="was_an_item_picked" targetRef="nothing_confirmed" />
    <bpmn:sequenceFlow id="flow_9" name="Picked" sourceRef="was_an_item_picked" targetRef="resolve_the_open_item_from_register_or_standing_rule" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="was_an_item_picked" targetRef="resolve_the_open_item_from_register_or_standing_rule" />
    <bpmn:sequenceFlow id="flow_11" name="No" sourceRef="is_an_open_item_named" targetRef="compose_the_landed_open_list" />
    <bpmn:sequenceFlow id="flow_12" name="An item is named" sourceRef="is_an_open_item_named" targetRef="resolve_the_open_item_from_register_or_standing_rule" />
    <bpmn:sequenceFlow id="flow_13" sourceRef="is_an_open_item_named" targetRef="resolve_the_open_item_from_register_or_standing_rule" />
    <bpmn:sequenceFlow id="flow_14" sourceRef="resolve_the_open_item_from_register_or_standing_rule" targetRef="does_the_item_still_lie_ahead_of_today" />
    <bpmn:sequenceFlow id="flow_15" sourceRef="refuse_to_confirm_money_that_has_not_moved" targetRef="the_open_item_stays_open" />
    <bpmn:sequenceFlow id="flow_16" name="Yes" sourceRef="does_the_item_still_lie_ahead_of_today" targetRef="refuse_to_confirm_money_that_has_not_moved" />
    <bpmn:sequenceFlow id="flow_17" name="Landed" sourceRef="does_the_item_still_lie_ahead_of_today" targetRef="does_the_item_carry_its_amount" />
    <bpmn:sequenceFlow id="flow_18" sourceRef="does_the_item_still_lie_ahead_of_today" targetRef="does_the_item_carry_its_amount" />
    <bpmn:sequenceFlow id="flow_19" sourceRef="refuse_to_confirm_a_movement_with_no_amount" targetRef="the_item_without_amount_stays_open" />
    <bpmn:sequenceFlow id="flow_20" name="No" sourceRef="does_the_item_carry_its_amount" targetRef="refuse_to_confirm_a_movement_with_no_amount" />
    <bpmn:sequenceFlow id="flow_21" name="Amount stated" sourceRef="does_the_item_carry_its_amount" targetRef="is_the_open_item_a_group" />
    <bpmn:sequenceFlow id="flow_22" sourceRef="does_the_item_carry_its_amount" targetRef="is_the_open_item_a_group" />
    <bpmn:sequenceFlow id="flow_23" sourceRef="collect_the_group_s_landed_members_in_day_order" targetRef="did_any_member_land" />
    <bpmn:sequenceFlow id="flow_24" sourceRef="commit_the_next_landed_member_as_an_actual_posting" targetRef="retire_the_member_s_open_item_and_re_point_its_address" />
    <bpmn:sequenceFlow id="flow_25" sourceRef="retire_the_member_s_open_item_and_re_point_its_address" targetRef="more_landed_members_pending" />
    <bpmn:sequenceFlow id="flow_26" name="Yes" sourceRef="more_landed_members_pending" targetRef="commit_the_next_landed_member_as_an_actual_posting" />
    <bpmn:sequenceFlow id="flow_27" sourceRef="more_landed_members_pending" targetRef="commit_the_item_as_an_actual_journal_posting" />
    <bpmn:sequenceFlow id="flow_28" name="Yes" sourceRef="did_any_member_land" targetRef="commit_the_next_landed_member_as_an_actual_posting" />
    <bpmn:sequenceFlow id="flow_29" name="No" sourceRef="did_any_member_land" targetRef="the_group_stands_as_it_was" />
    <bpmn:sequenceFlow id="flow_30" sourceRef="did_any_member_land" targetRef="commit_the_item_as_an_actual_journal_posting" />
    <bpmn:sequenceFlow id="flow_31" name="Yes" sourceRef="is_the_open_item_a_group" targetRef="collect_the_group_s_landed_members_in_day_order" />
    <bpmn:sequenceFlow id="flow_32" name="A single item" sourceRef="is_the_open_item_a_group" targetRef="commit_the_item_as_an_actual_journal_posting" />
    <bpmn:sequenceFlow id="flow_33" sourceRef="is_the_open_item_a_group" targetRef="commit_the_item_as_an_actual_journal_posting" />
    <bpmn:sequenceFlow id="flow_34" sourceRef="commit_the_item_as_an_actual_journal_posting" targetRef="retire_the_open_item_behind_the_posting" />
    <bpmn:sequenceFlow id="flow_35" sourceRef="retire_the_open_item_behind_the_posting" targetRef="did_the_posting_drift_from_its_standing_rule" />
    <bpmn:sequenceFlow id="flow_36" sourceRef="record_the_occurrence_as_an_exception" targetRef="report_the_outcome_with_the_new_account_state" />
    <bpmn:sequenceFlow id="flow_37" name="Yes" sourceRef="did_the_posting_drift_from_its_standing_rule" targetRef="record_the_occurrence_as_an_exception" />
    <bpmn:sequenceFlow id="flow_38" name="On mark" sourceRef="did_the_posting_drift_from_its_standing_rule" targetRef="report_the_outcome_with_the_new_account_state" />
    <bpmn:sequenceFlow id="flow_39" sourceRef="did_the_posting_drift_from_its_standing_rule" targetRef="report_the_outcome_with_the_new_account_state" />
    <bpmn:sequenceFlow id="flow_40" sourceRef="report_the_outcome_with_the_new_account_state" targetRef="open_item_committed" />
    <bpmn:sequenceFlow id="flow_41" name="No" sourceRef="more_landed_members_pending" targetRef="report_the_outcome_with_the_new_account_state" />
  </bpmn:process>
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="participant_owner" name="Owner" processRef="process_owner" />
    <bpmn:participant id="participant_open_entry_confirmation" name="Open-entry confirmation" processRef="process_open_entry_confirmation" />
    <bpmn:messageFlow id="messageflow_42" name="Confirm request" sourceRef="name_the_open_item_to_confirm" targetRef="confirm_request_arrives" />
    <bpmn:messageFlow id="messageflow_43" name="Future refusal" sourceRef="the_open_item_stays_open" targetRef="take_the_desk_s_answer" />
    <bpmn:messageFlow id="messageflow_44" name="Amount refusal" sourceRef="the_item_without_amount_stays_open" targetRef="take_the_desk_s_answer" />
    <bpmn:messageFlow id="messageflow_45" name="Cancelled" sourceRef="nothing_confirmed" targetRef="take_the_desk_s_answer" />
    <bpmn:messageFlow id="messageflow_46" name="Nothing landed" sourceRef="the_group_stands_as_it_was" targetRef="take_the_desk_s_answer" />
    <bpmn:messageFlow id="messageflow_47" name="Outcome" sourceRef="open_item_committed" targetRef="take_the_desk_s_answer" />
  </bpmn:collaboration>
