<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="definitions" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:process id="process_household_bookkeeper">
    <bpmn:userTask id="decide_to_confirm_the_landed_entry" name="Decide to confirm the landed entry" />
    <bpmn:startEvent id="a_planned_payment_has_landed_at_the_bank" name="A planned payment has landed at the bank" />
    <bpmn:exclusiveGateway id="is_the_confirmation_an_id_a_bare_confirm_or_a_group" name="Is the confirmation an id, a bare confirm or a group?" />
    <bpmn:userTask id="read_the_open_backlog_table_and_pick_an_entry" name="Read the open backlog table and pick an entry" />
    <bpmn:exclusiveGateway id="is_the_plan_dated_after_today_or_missing_its_amount" name="Is the plan dated after today or missing its amount?" />
    <bpmn:serviceTask id="book_the_planned_values_as_a_confirming_payment" name="Book the planned values as a confirming payment" />
    <bpmn:task id="strike_the_plan_from_the_expected_register" name="Strike the plan from the expected register" />
    <bpmn:endEvent id="plan_untouched" name="Plan untouched" />
    <bpmn:task id="refuse_with_a_note_that_nothing_was_confirmed" name="Refuse with a note that nothing was confirmed" />
    <bpmn:task id="confirm_the_new_balance_on_the_receipt" name="Confirm the new balance on the receipt" />
    <bpmn:endEvent id="plan_confirmed_as_booked_money" name="Plan confirmed as booked money" />
    <bpmn:serviceTask id="book_the_rule_s_own_values_with_no_questions" name="Book the rule's own values with no questions" />
    <bpmn:exclusiveGateway id="is_the_instance_dated_in_the_future" name="Is the instance dated in the future?" />
    <bpmn:exclusiveGateway id="is_the_confirmed_date_still_ahead_of_today" name="Is the confirmed date still ahead of today?" />
    <bpmn:userTask id="adjust_the_pre_filled_date_and_amount_for_the_early_landed_instance" name="Adjust the pre-filled date and amount for the early-landed instance" />
    <bpmn:serviceTask id="book_the_adjusted_values_and_record_an_exception_if_the_values_drifted" name="Book the adjusted values and record an exception if the values drifted" />
    <bpmn:endEvent id="instance_untouched" name="Instance untouched" />
    <bpmn:task id="refuse_a_real_payment_never_lies_in_the_future" name="Refuse — a real payment never lies in the future" />
    <bpmn:endEvent id="instance_confirmed_as_booked_money" name="Instance confirmed as booked money" />
    <bpmn:endEvent id="instance_committed_with_the_rule_s_values" name="Instance committed with the rule's values" />
    <bpmn:task id="re_point_each_confirmed_member_to_its_booking_in_the_group" name="Re-point each confirmed member to its booking in the group" />
    <bpmn:parallelGateway id="node22" />
    <bpmn:parallelGateway id="node23" />
    <bpmn:serviceTask id="book_each_landed_member_plan_with_its_own_confirming_payment" name="Book each landed member plan with its own confirming payment" />
    <bpmn:serviceTask id="book_each_landed_rule_instance_member_from_its_rule" name="Book each landed rule-instance member from its rule" />
    <bpmn:task id="report_the_skipped_members" name="Report the skipped members" />
    <bpmn:endEvent id="group_confirmed_as_far_as_it_landed" name="Group confirmed as far as it landed" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="a_planned_payment_has_landed_at_the_bank" targetRef="decide_to_confirm_the_landed_entry" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="decide_to_confirm_the_landed_entry" targetRef="is_the_confirmation_an_id_a_bare_confirm_or_a_group" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="book_the_planned_values_as_a_confirming_payment" targetRef="is_the_plan_dated_after_today_or_missing_its_amount" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="refuse_with_a_note_that_nothing_was_confirmed" targetRef="plan_untouched" />
    <bpmn:sequenceFlow id="flow_5" name="Yes" sourceRef="is_the_plan_dated_after_today_or_missing_its_amount" targetRef="refuse_with_a_note_that_nothing_was_confirmed" />
    <bpmn:sequenceFlow id="flow_6" name="No then book and strike the plan" sourceRef="is_the_plan_dated_after_today_or_missing_its_amount" targetRef="strike_the_plan_from_the_expected_register" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="is_the_plan_dated_after_today_or_missing_its_amount" targetRef="strike_the_plan_from_the_expected_register" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="strike_the_plan_from_the_expected_register" targetRef="confirm_the_new_balance_on_the_receipt" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="confirm_the_new_balance_on_the_receipt" targetRef="plan_confirmed_as_booked_money" />
    <bpmn:sequenceFlow id="flow_10" name="An id of a landed plan" sourceRef="is_the_confirmation_an_id_a_bare_confirm_or_a_group" targetRef="book_the_planned_values_as_a_confirming_payment" />
    <bpmn:sequenceFlow id="flow_11" sourceRef="adjust_the_pre_filled_date_and_amount_for_the_early_landed_instance" targetRef="is_the_confirmed_date_still_ahead_of_today" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="refuse_a_real_payment_never_lies_in_the_future" targetRef="instance_untouched" />
    <bpmn:sequenceFlow id="flow_13" name="Yes" sourceRef="is_the_confirmed_date_still_ahead_of_today" targetRef="refuse_a_real_payment_never_lies_in_the_future" />
    <bpmn:sequenceFlow id="flow_14" name="No then commit" sourceRef="is_the_confirmed_date_still_ahead_of_today" targetRef="book_the_adjusted_values_and_record_an_exception_if_the_values_drifted" />
    <bpmn:sequenceFlow id="flow_15" sourceRef="is_the_confirmed_date_still_ahead_of_today" targetRef="book_the_adjusted_values_and_record_an_exception_if_the_values_drifted" />
    <bpmn:sequenceFlow id="flow_16" sourceRef="book_the_adjusted_values_and_record_an_exception_if_the_values_drifted" targetRef="instance_confirmed_as_booked_money" />
    <bpmn:sequenceFlow id="flow_17" name="Yes" sourceRef="is_the_instance_dated_in_the_future" targetRef="adjust_the_pre_filled_date_and_amount_for_the_early_landed_instance" />
    <bpmn:sequenceFlow id="flow_18" name="No land today then commit as-is" sourceRef="is_the_instance_dated_in_the_future" targetRef="book_the_rule_s_own_values_with_no_questions" />
    <bpmn:sequenceFlow id="flow_19" sourceRef="is_the_instance_dated_in_the_future" targetRef="book_the_rule_s_own_values_with_no_questions" />
    <bpmn:sequenceFlow id="flow_20" sourceRef="book_the_rule_s_own_values_with_no_questions" targetRef="instance_committed_with_the_rule_s_values" />
    <bpmn:sequenceFlow id="flow_21" name="An id of a due rule instance" sourceRef="is_the_confirmation_an_id_a_bare_confirm_or_a_group" targetRef="is_the_instance_dated_in_the_future" />
    <bpmn:sequenceFlow id="flow_24" sourceRef="book_each_landed_member_plan_with_its_own_confirming_payment" targetRef="node23" />
    <bpmn:sequenceFlow id="flow_25" sourceRef="node22" targetRef="book_each_landed_member_plan_with_its_own_confirming_payment" />
    <bpmn:sequenceFlow id="flow_26" sourceRef="book_each_landed_rule_instance_member_from_its_rule" targetRef="node23" />
    <bpmn:sequenceFlow id="flow_27" sourceRef="node22" targetRef="book_each_landed_rule_instance_member_from_its_rule" />
    <bpmn:sequenceFlow id="flow_28" sourceRef="node23" targetRef="re_point_each_confirmed_member_to_its_booking_in_the_group" />
    <bpmn:sequenceFlow id="flow_29" sourceRef="re_point_each_confirmed_member_to_its_booking_in_the_group" targetRef="report_the_skipped_members" />
    <bpmn:sequenceFlow id="flow_30" sourceRef="report_the_skipped_members" targetRef="group_confirmed_as_far_as_it_landed" />
    <bpmn:sequenceFlow id="flow_31" name="A group id" sourceRef="is_the_confirmation_an_id_a_bare_confirm_or_a_group" targetRef="node22" />
    <bpmn:sequenceFlow id="flow_32" name="Bare confirm with no id" sourceRef="is_the_confirmation_an_id_a_bare_confirm_or_a_group" targetRef="read_the_open_backlog_table_and_pick_an_entry" />
    <bpmn:sequenceFlow id="flow_33" sourceRef="is_the_confirmation_an_id_a_bare_confirm_or_a_group" targetRef="read_the_open_backlog_table_and_pick_an_entry" />
    <bpmn:sequenceFlow id="flow_34" sourceRef="read_the_open_backlog_table_and_pick_an_entry" targetRef="decide_to_confirm_the_landed_entry" />
  </bpmn:process>
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="participant_household_bookkeeper" name="Household bookkeeper" processRef="process_household_bookkeeper" />
  </bpmn:collaboration>
