process "household bookkeeper"
  start "A spend or income happens or is remembered"
  send "Record the movement (financials add)"
  receive "Take in the saved confirmation"
  end "The recording is accounted for"

process "transaction entry interface"
  start "Start the intake"
  task "Take in the entry's details, asking for anything missing"
  exclusive "Did the quick-add line fail or the bookkeeper abandon?"
    if "Stopped" then end "Nothing stored — the stop is shown"
    else "Proceed"
  exclusive "Entered through the prompts?"
    if "Yes" then task "Confirm the projected checking balance"
    else "No"
  task "Check the details date, description, approved category and non-zero amount"
  exclusive "Are all details accepted?"
    if "No" then end "Nothing stored — the refusal is shown"
    else "Accepted"
  exclusive "Is the entry dated after today?"
    if "Future entry" then send "Hand the entry to the expected register"
    else "Actual entry" send "Post the movement to the journaled ledger"
  task "Echo the saved entry and its resulting balances"
  end "The recording is saved"

process "expected register store"
  start "Park the plan"
  task "Check the plan is strictly future-dated in an approved category"
  task "Save the parked plan as given — amount 0 parks a placeholder"
  end "The plan is parked"

process "journaled ledger engine"
  start "Apply the movement"
  task "Give the recording its identity — creation time and content hash"
  task "Append the recording to the journal"
  task "Rebuild the books and place the entry at its date"
  task "Carry the running balances forward through every later row"
  task "Persist the settled checkpoint"
  end "The movement is posted"

message flows
  from "household bookkeeper"."Record the movement (financials add)" to "transaction entry interface"."Start the intake" label "Recording request"
  from "transaction entry interface"."Hand the entry to the expected register" to "expected register store"."Park the plan" label "Future entry"
  from "transaction entry interface"."Post the movement to the journaled ledger" to "journaled ledger engine"."Apply the movement" label "Actual entry"
  from "expected register store"."The plan is parked" to "transaction entry interface"."Echo the saved entry and its resulting balances" label "Parked confirmation"
  from "journaled ledger engine"."The movement is posted" to "transaction entry interface"."Echo the saved entry and its resulting balances" label "Applied confirmation"
  from "transaction entry interface"."Echo the saved entry and its resulting balances" to "household bookkeeper"."Take in the saved confirmation" label "Saved confirmation"

