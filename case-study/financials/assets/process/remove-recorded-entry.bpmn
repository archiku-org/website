<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="definitions" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:process id="process_owner">
    <bpmn:userTask id="invoke_the_delete_command_by_id_or_pick_from_the_recent_rows" name="Invoke the delete command by id or pick from the recent rows" />
    <bpmn:startEvent id="a_recorded_entry_must_not_be_in_the_books" name="A recorded entry must not be in the books" />
    <bpmn:receiveTask id="consider_the_shown_entry_and_the_confirmation_request" name="Consider the shown entry and the confirmation request" />
    <bpmn:userTask id="type_the_confirmation" name="Type the confirmation" />
    <bpmn:receiveTask id="see_the_removal_outcome" name="See the removal outcome" />
    <bpmn:endEvent id="the_books_reflect_the_removal_or_the_cancellation" name="The books reflect the removal or the cancellation" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="a_recorded_entry_must_not_be_in_the_books" targetRef="invoke_the_delete_command_by_id_or_pick_from_the_recent_rows" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="invoke_the_delete_command_by_id_or_pick_from_the_recent_rows" targetRef="consider_the_shown_entry_and_the_confirmation_request" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="consider_the_shown_entry_and_the_confirmation_request" targetRef="type_the_confirmation" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="type_the_confirmation" targetRef="see_the_removal_outcome" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="see_the_removal_outcome" targetRef="the_books_reflect_the_removal_or_the_cancellation" />
  </bpmn:process>
  <bpmn:process id="process_financials_delete_command">
    <bpmn:task id="resolve_the_entry_s_kind_across_the_registers" name="Resolve the entry's kind across the registers" />
    <bpmn:startEvent id="delete_request_arrives" name="Delete request arrives" />
    <bpmn:exclusiveGateway id="entry_found" name="Entry found?" />
    <bpmn:task id="show_the_entry_and_ask_for_the_typed_yes" name="Show the entry and ask for the typed yes" />
    <bpmn:endEvent id="unknown_id_refused" name="Unknown id refused" />
    <bpmn:task id="refuse_the_unknown_id_and_change_nothing" name="Refuse the unknown id and change nothing" />
    <bpmn:receiveTask id="receive_the_typed_answer" name="Receive the typed answer" />
    <bpmn:exclusiveGateway id="typed_yes" name="Typed yes?" />
    <bpmn:exclusiveGateway id="which_kind_of_entry" name="Which kind of entry?" />
    <bpmn:endEvent id="removal_cancelled" name="Removal cancelled" />
    <bpmn:task id="leave_the_books_untouched" name="Leave the books untouched" />
    <bpmn:endEvent id="removal_handled" name="Removal handled" />
    <bpmn:task id="re_earn_the_later_rows_saldos" name="Re-earn the later rows' saldos" />
    <bpmn:task id="append_the_delete_event_carrying_the_row_s_full_picture" name="Append the delete event carrying the row's full picture" />
    <bpmn:task id="warn_about_the_touched_savings_chain_when_a_transfer_was_removed" name="Warn about the touched savings chain when a transfer was removed" />
    <bpmn:task id="withdraw_the_row_from_the_register_of_expectations" name="Withdraw the row from the register of expectations" />
    <bpmn:task id="dissolve_the_group_and_leave_the_members_untouched" name="Dissolve the group and leave the members untouched" />
    <bpmn:task id="add_the_date_to_the_rule_s_exceptions" name="Add the date to the rule's exceptions" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="delete_request_arrives" targetRef="resolve_the_entry_s_kind_across_the_registers" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="resolve_the_entry_s_kind_across_the_registers" targetRef="entry_found" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="refuse_the_unknown_id_and_change_nothing" targetRef="unknown_id_refused" />
    <bpmn:sequenceFlow id="flow_9" name="No" sourceRef="entry_found" targetRef="refuse_the_unknown_id_and_change_nothing" />
    <bpmn:sequenceFlow id="flow_10" name="Yes" sourceRef="entry_found" targetRef="show_the_entry_and_ask_for_the_typed_yes" />
    <bpmn:sequenceFlow id="flow_11" sourceRef="entry_found" targetRef="show_the_entry_and_ask_for_the_typed_yes" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="show_the_entry_and_ask_for_the_typed_yes" targetRef="receive_the_typed_answer" />
    <bpmn:sequenceFlow id="flow_13" sourceRef="receive_the_typed_answer" targetRef="typed_yes" />
    <bpmn:sequenceFlow id="flow_14" sourceRef="leave_the_books_untouched" targetRef="removal_cancelled" />
    <bpmn:sequenceFlow id="flow_15" name="No" sourceRef="typed_yes" targetRef="leave_the_books_untouched" />
    <bpmn:sequenceFlow id="flow_16" name="Yes" sourceRef="typed_yes" targetRef="which_kind_of_entry" />
    <bpmn:sequenceFlow id="flow_17" sourceRef="typed_yes" targetRef="which_kind_of_entry" />
    <bpmn:sequenceFlow id="flow_18" sourceRef="append_the_delete_event_carrying_the_row_s_full_picture" targetRef="re_earn_the_later_rows_saldos" />
    <bpmn:sequenceFlow id="flow_19" sourceRef="re_earn_the_later_rows_saldos" targetRef="warn_about_the_touched_savings_chain_when_a_transfer_was_removed" />
    <bpmn:sequenceFlow id="flow_20" sourceRef="warn_about_the_touched_savings_chain_when_a_transfer_was_removed" targetRef="removal_handled" />
    <bpmn:sequenceFlow id="flow_21" name="Committed ledger row" sourceRef="which_kind_of_entry" targetRef="append_the_delete_event_carrying_the_row_s_full_picture" />
    <bpmn:sequenceFlow id="flow_22" sourceRef="withdraw_the_row_from_the_register_of_expectations" targetRef="removal_handled" />
    <bpmn:sequenceFlow id="flow_23" name="Future expectation" sourceRef="which_kind_of_entry" targetRef="withdraw_the_row_from_the_register_of_expectations" />
    <bpmn:sequenceFlow id="flow_24" sourceRef="dissolve_the_group_and_leave_the_members_untouched" targetRef="removal_handled" />
    <bpmn:sequenceFlow id="flow_25" name="Statement group" sourceRef="which_kind_of_entry" targetRef="dissolve_the_group_and_leave_the_members_untouched" />
    <bpmn:sequenceFlow id="flow_26" sourceRef="add_the_date_to_the_rule_s_exceptions" targetRef="removal_handled" />
    <bpmn:sequenceFlow id="flow_27" name="Projected rule date" sourceRef="which_kind_of_entry" targetRef="add_the_date_to_the_rule_s_exceptions" />
    <bpmn:sequenceFlow id="flow_28" sourceRef="which_kind_of_entry" targetRef="removal_handled" />
  </bpmn:process>
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="participant_owner" name="Owner" processRef="process_owner" />
    <bpmn:participant id="participant_financials_delete_command" name="financials delete command" processRef="process_financials_delete_command" />
    <bpmn:messageFlow id="messageflow_29" name="Removal request" sourceRef="invoke_the_delete_command_by_id_or_pick_from_the_recent_rows" targetRef="delete_request_arrives" />
    <bpmn:messageFlow id="messageflow_30" name="Confirmation request" sourceRef="show_the_entry_and_ask_for_the_typed_yes" targetRef="consider_the_shown_entry_and_the_confirmation_request" />
    <bpmn:messageFlow id="messageflow_31" name="Owner's answer" sourceRef="type_the_confirmation" targetRef="receive_the_typed_answer" />
    <bpmn:messageFlow id="messageflow_32" name="Refusal" sourceRef="unknown_id_refused" targetRef="see_the_removal_outcome" />
    <bpmn:messageFlow id="messageflow_33" name="Cancellation" sourceRef="removal_cancelled" targetRef="see_the_removal_outcome" />
    <bpmn:messageFlow id="messageflow_34" name="Outcome" sourceRef="removal_handled" targetRef="see_the_removal_outcome" />
  </bpmn:collaboration>
